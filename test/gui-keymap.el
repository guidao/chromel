;;; gui-keymap.el --- Vimium commands with real CEF views -*- lexical-binding: t; -*-
(require 'chromel)
;; Optional: pass Meow on load-path to exercise the real motion state as well.
(when (require 'meow nil t)
  (meow-motion-define-key '("j" . meow-next) '("k" . meow-prev))
  (meow-global-mode 1))
(setq chromel-data-directory (file-name-as-directory (getenv "CHROMEL_TEST_PROFILE")))
(defvar chromel-test--source nil)
(defvar chromel-test--background nil)
(defvar chromel-test--third nil)
(defvar chromel-test--busy nil)
(defvar chromel-test--phase 'loading)
(defvar chromel-test--deadline (+ (float-time) 40))
(defun chromel-test--assert (value text) (unless value (error "%s" text)))
(defun chromel-test--finish (ok text)
  (with-temp-file (getenv "CHROMEL_TEST_RESULT") (insert (if ok "PASS: " "FAIL: ") text "\n"))
  (kill-emacs (if ok 0 1)))
(defun chromel-test--keys (keys)
  (execute-kbd-macro (kbd keys)))
(defun chromel-test--selected (buffer)
  (chromel-test--assert (eq buffer (window-buffer (selected-window))) "Wrong browser selected")
  (chromel-test--assert
   (eq :false (plist-get (json-parse-string (chromel--native-inspect
                                           (buffer-local-value 'chromel--id buffer)) :object-type 'plist)
                        :focused)) "Browser stole command focus")
  (when (bound-and-true-p meow-global-mode)
    (chromel-test--assert (buffer-local-value 'meow-motion-mode buffer) "Browser not in Meow motion state")
    (chromel-test--assert (eq (key-binding (kbd "SPC")) 'meow-keypad) "SPC keypad lost")))
(defun chromel-test--until (expression)
  (let ((deadline (+ (float-time) 3)) done)
    (while (and (not done) (< (float-time) deadline))
      (setq done (eq t (chromel--eval (concat "JSON.stringify(" expression ")"))))
      (unless done (accept-process-output nil 0.01)))
    (chromel-test--assert done (concat "Page assertion failed: " expression))))
(defun chromel-test--step ()
  (unless chromel-test--busy
    (let ((chromel-test--busy t))
      (with-current-buffer (window-buffer (selected-window))
        (condition-case err
            (progn
              (when (> (float-time) chromel-test--deadline) (error "Keymap timed out"))
              (pcase chromel-test--phase
                ('loading
                 (when (equal (buffer-local-value 'chromel--title chromel-test--source)
                              (getenv "CHROMEL_TEST_EXPECT_TITLE"))
                   (switch-to-buffer chromel-test--source)
                   (delete-other-windows)
                   (chromel--sync)
                   (chromel--command "unfocus")
                   (chromel-test--selected chromel-test--source)
                   (let ((chromel-scroll-duration 0))
                     (chromel-test--keys "G")
                     (chromel-test--until "scrollY>1000")
                     (chromel-test--keys "g g")
                     (chromel-test--until "scrollY===0"))
                   (cl-letf (((symbol-function 'chromel--read-hint)
                              (lambda (hints _)
                                (or (cl-find-if (lambda (hint)
                                                  (let ((url (plist-get hint :url)))
                                                    (and (stringp url) (string-suffix-p "/hint-target" url)))) hints)
                                    (error "Missing fixture link")))))
                     (chromel-test--keys "F"))
                   (setq chromel-test--phase 'background)))
                ('background
                 (when (= (length (chromel--buffers)) 2)
                   (setq chromel-test--background (cadr (chromel--buffers)))
                   (when (equal (buffer-local-value 'chromel--title chromel-test--background) "hint-target")
                     (chromel-test--selected chromel-test--source)
                     (let ((info (json-parse-string (chromel--native-inspect
                                                    (buffer-local-value 'chromel--id chromel-test--background))
                                                   :object-type 'plist)))
                       (chromel-test--assert (eq t (plist-get info :hidden)) "F showed a background page"))
                     (let ((chromel-home-url (getenv "CHROMEL_TEST_URL"))) (chromel-test--keys "t"))
                     (setq chromel-test--third (window-buffer (selected-window)))
                     (chromel-test--selected chromel-test--third)
                     (chromel-test--assert (= (length (chromel--buffers)) 3) "t did not create a browser")
                     (setq chromel-test--phase 'tabs))))
                ('tabs
                 (when (equal (buffer-local-value 'chromel--title chromel-test--third) "chromel-emacs-restored")
                   (chromel-test--keys "J") (chromel-test--selected chromel-test--background)
                   (chromel-test--keys "K") (chromel-test--selected chromel-test--third)
                   (chromel-test--keys "g t") (chromel-test--selected chromel-test--source)
                   (chromel-test--keys "g T") (chromel-test--selected chromel-test--third)
                   (chromel-test--keys "^") (chromel-test--selected chromel-test--source)
                   (chromel-test--keys "^") (chromel-test--selected chromel-test--third)
                   (cl-letf (((symbol-function 'completing-read)
                              (lambda (_ choices &rest _)
                                (car (rassq chromel-test--background choices)))))
                     (chromel-test--keys "T"))
                   (chromel-test--selected chromel-test--background)
                   (chromel-test--keys "x") (chromel-test--selected chromel-test--third)
                   (chromel-test--assert (not (buffer-live-p chromel-test--background)) "x retained browser")
                   (chromel-test--keys "x") (chromel-test--selected chromel-test--source)
                   (chromel-test--keys "x")
                   (chromel-test--assert (null (chromel--buffers)) "Last x retained browser")
                   (setq chromel-test--phase 'closing)))
                ('closing
                 (when (string-match-p "Browsers including DevTools: 0" (chromel--native-info))
                   (chromel-test--finish t "Vimium keys: gg/G, background F, t/J/K/gt/gT/T/^/x, command focus and native cleanup")))))
          (error (chromel-test--finish nil (format "%s (phase %s)" (error-message-string err) chromel-test--phase))))))))
(run-at-time 1 nil
             (lambda ()
               (condition-case err
                   (progn
                     (setq chromel-test--source (chromel (getenv "CHROMEL_TEST_URL")))
                     (run-at-time 0.1 0.1 #'chromel-test--step))
                 (error (chromel-test--finish nil (error-message-string err))))))
