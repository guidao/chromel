;;; gui-hold.el --- Physical hold/release and keymap regression -*- lexical-binding: t; -*-
(require 'web)
(setq web-data-directory (file-name-as-directory (getenv "WEB_TEST_PROFILE")))
(defvar web-test--source nil)
(defvar web-test--measurements nil)
(defvar web-test--busy nil)
(defvar web-test--phase 'loading)
(defvar web-test--deadline (+ (float-time) 45))
(defun web-test--assert (value text) (unless value (error "%s" text)))
(defun web-test--js (expression) (web--eval (concat "JSON.stringify(" expression ")")))
(defun web-test--until (expression description)
  (let ((deadline (+ (float-time) 4)) done)
    (while (and (not done) (< (float-time) deadline))
      (setq done (eq t (web-test--js expression)))
      (unless done (accept-process-output nil 0.01)))
    (web-test--assert done description)))
(defun web-test--finish (success description)
  (with-temp-file (getenv "WEB_TEST_RESULT")
    (insert (if success "PASS: " "FAIL: ") description "\n"))
  (kill-emacs (if success 0 1)))
(defun web-test--still (expression)
  ;; Allow the one in-flight renderer frame before checking that release has
  ;; actually stopped, rather than demanding synchronous cross-process IPC.
  (accept-process-output nil 0.1)
  (let ((position (web-test--js expression)))
    (accept-process-output nil 0.18)
    (web-test--assert (= position (web-test--js expression)) "Released/cancelled key kept scrolling")))
(defun web-test--exercise ()
  (dolist (entry '(("same" 80 80) ("cross" 380 80) ("nested" 380 140)))
    (let* ((name (car entry)) (position (format "frameState.%s.y" name)))
      (web-focus)
      (web--command "click" (web--json (list :x (cadr entry) :y (caddr entry) :newBuffer :false)))
      (let ((deadline (+ (float-time) 3)))
        (while (and (< (float-time) deadline)
                    (not (equal name (plist-get (json-parse-string (web--native-inspect web--id) :object-type 'plist) :focusedFrameName))))
          (accept-process-output nil 0.02)))
      (web--command "test-key-down" "j")
      ;; No repeat events at all: the renderer must keep scrolling on its own.
      (web-test--until (concat position ">200") (concat "Hold stopped at one step: " name))
      (let ((before (web-test--js position)))
        (dotimes (_ 20) (web--command "test-key-repeat" "j"))
        (web--command "test-key-up" "j")
        (web-test--still position)
        (web-test--assert (< (- (web-test--js position) before) 180) "Repeats added queued distance"))
      (let ((before (web-test--js position)))
        (web--command "test-key-down" "k")
        (web-test--until (format "%s<%s" position (- before 80)) "Held k did not reverse")
        (web--command "test-key-up" "k")
        (web-test--still position))
      ;; Same physical observer + actual Emacs keymap/Meow dispatch.  The
      ;; observer alone is deliberately insufficient to begin scrolling.
      (web--command "unfocus")
      (web--command "test-command-down" "j")
      (let ((before (web-test--js position))
            (overriding-local-map (let ((map (make-sparse-keymap))) (define-key map "j" #'ignore) map)))
        (execute-kbd-macro "j")
        (accept-process-output nil 0.2)
        (web-test--assert (= before (web-test--js position)) "Native observer bypassed the Emacs keymap"))
      (web--command "test-command-up" "j")
      (let ((before (web-test--js position)))
        (web--command "test-command-down" "j")
        (execute-kbd-macro "j")
        (web-test--until (format "%s>%s" position (+ before 160)) "Meow command did not arm hold")
        (web--command "test-command-up" "j")
        (web-test--still position))
      (web-test--assert (= 0 (web-test--js "scrollY")) "Iframe hold escaped to outer page")))
  ;; Collect real renderer frame samples after the acceleration interval.
  (web-focus-main-frame)
  (web-focus)
  ;; Separate quick taps must retain both full steps while their animations overlap.
  (web-test--js "(()=>{window.holdStarts=0;const hold=__emacsWebScroller.hold;__emacsWebScroller.hold=function(...args){holdStarts++;return hold.apply(this,args)};return true})()")
  (web--command "test-key-down" "j")
  (web-test--until "scrollY>0" "First quick tap did not start")
  (web--command "test-key-up" "j")
  (let ((before (web-test--js "scrollY")))
    (web--command "test-key-down" "j")
    (web-test--until (format "scrollY>%s && holdStarts===2" before) "Second quick tap did not start"))
  (web--command "test-key-up" "j")
  (web-test--until "scrollY===120" "Overlapping quick taps lost their total distance")
  (web-test--still "scrollY")
  (let ((web-scroll-duration 0)) (web-scroll-to-top))
  (web-test--until "scrollY===0" "Could not reset after quick taps")
  (web-test--js "(()=>{window.holdSamples=[];window.holdSampling=true;function sample(t){holdSamples.push([t,scrollY]);if(holdSampling)requestAnimationFrame(sample)}requestAnimationFrame(sample);return true})()")
  (web--command "test-key-down" "j")
  (web-test--until "scrollY>500" "Outer hold did not continue")
  (web--command "test-key-up" "j")
  (web-test--js "(holdSampling=false,true)")
  (web-test--still "scrollY")
  (let ((metrics (web-test--js "(()=>{const first=holdSamples.find(s=>s[1]>0);const v=holdSamples.slice(1).map((s,i)=>({dt:s[0]-holdSamples[i][0],dy:s[1]-holdSamples[i][1],t:s[0]})).filter(s=>first&&s.t>first[0]+250&&s.dy>0&&s.dt>0).map(s=>s.dy/s.dt*1000);return {count:v.length,min:Math.min(...v),max:Math.max(...v)}})()")))
    (web-test--assert (> (plist-get metrics :count) 5) "Insufficient steady-state frame samples")
    (web-test--assert (and (> (plist-get metrics :min) 650) (< (plist-get metrics :max) 1150))
                      (format "Uneven steady-state velocity: %S" metrics))
    (setq web-test--measurements metrics))
  ;; Reverse without first releasing j; its late keyup must not stop k.
  (web--command "test-key-down" "j")
  (let ((before (web-test--js "scrollY")))
    (web-test--until (format "scrollY>%s" (+ before 100)) "Reversal hold did not start"))
  (let ((before (web-test--js "scrollY")))
    (web--command "test-key-down" "k")
    (web-test--until (format "scrollY<%s" (- before 80)) "Immediate reversal did not keep scrolling"))
  (web--command "test-key-up" "j")
  (let ((before (web-test--js "scrollY")))
    (web-test--until (format "scrollY<%s" (- before 80)) "Old keyup cancelled the new direction"))
  (web--command "test-key-up" "k")
  (web-test--still "scrollY")
  ;; Selection loss stops a held key even if its keyup never reaches this view.
  (web--command "test-key-down" "j")
  (let ((before (web-test--js "scrollY")))
    (web-test--until (format "scrollY>%s" (+ before 100)) "Cancellation hold did not start"))
  (web--command "selected" "0")
  (web-test--still "scrollY")
  (web--command "test-key-up" "j")
  ;; Instant mode retains keyboard-repeat distances, without a runaway hold.
  (let ((web-scroll-duration 0) (before (web-test--js "scrollY")))
    (web--sync)
    (web--command "test-key-down" "j")
    (web-test--until (format "scrollY===%s" (+ before 60)) "Instant keydown failed")
    (web--command "test-key-repeat" "j")
    (web-test--until (format "scrollY===%s" (+ before 120)) "Instant repeat lost distance")
    (web--command "test-key-up" "j")
    (web-test--still "scrollY"))
  ;; Exercise reduced-motion behavior even on a machine without that setting.
  (web-test--js "(()=>{window.savedMatchMedia=window.matchMedia;window.matchMedia=q=>q==='(prefers-reduced-motion: reduce)'?{matches:true}:savedMatchMedia(q);return true})()")
  (web--sync)
  (let ((before (web-test--js "scrollY")))
    (web--command "test-key-down" "j")
    (web-test--until (format "scrollY===%s" (+ before 60)) "Reduced-motion keydown failed")
    (web--command "test-key-repeat" "j")
    (web-test--until (format "scrollY===%s" (+ before 120)) "Reduced-motion repeat failed")
    (web--command "test-key-up" "j")
    (web-test--still "scrollY"))
  (web-test--js "(window.matchMedia=window.savedMatchMedia,true)"))
(defun web-test--step ()
  (unless web-test--busy
    (let ((web-test--busy t))
      (with-current-buffer (if (buffer-live-p web-test--source) web-test--source (current-buffer))
        (condition-case err
            (progn
              (when (> (float-time) web-test--deadline) (error "Hold test timed out"))
              (pcase web-test--phase
                ('loading
                 (when (equal web--title "scroll-ready")
                   (switch-to-buffer web-test--source)
                   (delete-other-windows)
                   (web--sync)
                   (web-test--until "Boolean(frameState.same && frameState.cross && frameState.nested)" "Frames did not load")
                   (web-test--exercise)
                   (kill-buffer web-test--source)
                   (setq web-test--phase 'closing)))
                ('closing
                 (when (string-match-p "Browsers including DevTools: 0" (web--native-info))
                   (web-test--finish t (format "Physical hold/release: iframe routing, repeat independence, Meow dispatch/keymap override, selection cancellation, reversal, overlapping taps, instant/reduced-motion repeats; steady velocity %S CSS px/s" web-test--measurements))))))
          (error (web-test--finish nil (error-message-string err))))))))
(run-at-time 1 nil
             (lambda ()
               (condition-case err
                   (progn
                     (set-frame-size nil 1100 750 t)
                     (setq web-test--source (web (getenv "WEB_TEST_URL")))
                     (run-at-time 0.2 0.2 #'web-test--step))
                 (error (web-test--finish nil (error-message-string err))))))
