;;; gui-hold.el --- Physical hold/release and keymap regression -*- lexical-binding: t; -*-
(require 'chromel)
(setq chromel-data-directory (file-name-as-directory (getenv "CHROMEL_TEST_PROFILE")))
(defvar chromel-test--source nil)
(defvar chromel-test--measurements nil)
(defvar chromel-test--busy nil)
(defvar chromel-test--phase 'loading)
(defvar chromel-test--deadline (+ (float-time) 45))
(defun chromel-test--assert (value text) (unless value (error "%s" text)))
(defun chromel-test--js (expression) (chromel--eval (concat "JSON.stringify(" expression ")")))
(defun chromel-test--until (expression description)
  (let ((deadline (+ (float-time) 4)) done)
    (while (and (not done) (< (float-time) deadline))
      (setq done (eq t (chromel-test--js expression)))
      (unless done (accept-process-output nil 0.01)))
    (chromel-test--assert done description)))
(defun chromel-test--finish (success description)
  (with-temp-file (getenv "CHROMEL_TEST_RESULT")
    (insert (if success "PASS: " "FAIL: ") description "\n"))
  (kill-emacs (if success 0 1)))
(defun chromel-test--still (expression)
  ;; Allow the one in-flight renderer frame before checking that release has
  ;; actually stopped, rather than demanding synchronous cross-process IPC.
  (accept-process-output nil 0.1)
  (let ((position (chromel-test--js expression)))
    (accept-process-output nil 0.18)
    (chromel-test--assert (= position (chromel-test--js expression)) "Released/cancelled key kept scrolling")))
(defun chromel-test--exercise ()
  (dolist (entry '(("same" 80 80) ("cross" 380 80) ("nested" 380 140)))
    (let* ((name (car entry)) (position (format "frameState.%s.y" name)))
      (chromel-focus)
      (chromel--command "click" (chromel--json (list :x (cadr entry) :y (caddr entry) :newBuffer :false)))
      (let ((deadline (+ (float-time) 3)))
        (while (and (< (float-time) deadline)
                    (not (equal name (plist-get (json-parse-string (chromel--native-inspect chromel--id) :object-type 'plist) :focusedFrameName))))
          (accept-process-output nil 0.02)))
      (chromel--command "test-key-down" "j")
      ;; No repeat events at all: the renderer must keep scrolling on its own.
      (chromel-test--until (concat position ">200") (concat "Hold stopped at one step: " name))
      (let ((before (chromel-test--js position)))
        (dotimes (_ 20) (chromel--command "test-key-repeat" "j"))
        (chromel--command "test-key-up" "j")
        (chromel-test--still position)
        (chromel-test--assert (< (- (chromel-test--js position) before) 180) "Repeats added queued distance"))
      (let ((before (chromel-test--js position)))
        (chromel--command "test-key-down" "k")
        (chromel-test--until (format "%s<%s" position (- before 80)) "Held k did not reverse")
        (chromel--command "test-key-up" "k")
        (chromel-test--still position))
      ;; Same physical observer + actual Emacs keymap/Meow dispatch.  The
      ;; observer alone is deliberately insufficient to begin scrolling.
      (chromel--command "unfocus")
      (chromel--command "test-command-down" "j")
      (let ((before (chromel-test--js position))
            (overriding-local-map (let ((map (make-sparse-keymap))) (define-key map "j" #'ignore) map)))
        (execute-kbd-macro "j")
        (accept-process-output nil 0.2)
        (chromel-test--assert (= before (chromel-test--js position)) "Native observer bypassed the Emacs keymap"))
      (chromel--command "test-command-up" "j")
      (let ((before (chromel-test--js position)))
        (chromel--command "test-command-down" "j")
        (execute-kbd-macro "j")
        (chromel-test--until (format "%s>%s" position (+ before 160)) "Meow command did not arm hold")
        (chromel--command "test-command-up" "j")
        (chromel-test--still position))
      (chromel-test--assert (= 0 (chromel-test--js "scrollY")) "Iframe hold escaped to outer page")))
  ;; Collect real renderer frame samples after the acceleration interval.
  (chromel-focus-main-frame)
  (chromel-focus)
  ;; Separate quick taps must retain both full steps while their animations overlap.
  (chromel-test--js "(()=>{window.holdStarts=0;const hold=__emacsChromelScroller.hold;__emacsChromelScroller.hold=function(...args){holdStarts++;return hold.apply(this,args)};return true})()")
  (chromel--command "test-key-down" "j")
  (chromel-test--until "scrollY>0" "First quick tap did not start")
  (chromel--command "test-key-up" "j")
  (let ((before (chromel-test--js "scrollY")))
    (chromel--command "test-key-down" "j")
    (chromel-test--until (format "scrollY>%s && holdStarts===2" before) "Second quick tap did not start"))
  (chromel--command "test-key-up" "j")
  (chromel-test--until "scrollY===120" "Overlapping quick taps lost their total distance")
  (chromel-test--still "scrollY")
  (let ((chromel-scroll-duration 0)) (chromel-scroll-to-top))
  (chromel-test--until "scrollY===0" "Could not reset after quick taps")
  (chromel-test--js "(()=>{window.holdSamples=[];window.holdSampling=true;function sample(t){holdSamples.push([t,scrollY]);if(holdSampling)requestAnimationFrame(sample)}requestAnimationFrame(sample);return true})()")
  (chromel--command "test-key-down" "j")
  (chromel-test--until "scrollY>500" "Outer hold did not continue")
  (chromel--command "test-key-up" "j")
  (chromel-test--js "(holdSampling=false,true)")
  (chromel-test--still "scrollY")
  (let ((metrics (chromel-test--js "(()=>{const first=holdSamples.find(s=>s[1]>0);const v=holdSamples.slice(1).map((s,i)=>({dt:s[0]-holdSamples[i][0],dy:s[1]-holdSamples[i][1],t:s[0]})).filter(s=>first&&s.t>first[0]+250&&s.dy>0&&s.dt>0).map(s=>s.dy/s.dt*1000);return {count:v.length,min:Math.min(...v),max:Math.max(...v)}})()")))
    (chromel-test--assert (> (plist-get metrics :count) 5) "Insufficient steady-state frame samples")
    (chromel-test--assert (and (> (plist-get metrics :min) 650) (< (plist-get metrics :max) 1150))
                      (format "Uneven steady-state velocity: %S" metrics))
    (setq chromel-test--measurements metrics))
  ;; Reverse without first releasing j; its late keyup must not stop k.
  (chromel--command "test-key-down" "j")
  (let ((before (chromel-test--js "scrollY")))
    (chromel-test--until (format "scrollY>%s" (+ before 100)) "Reversal hold did not start"))
  (let ((before (chromel-test--js "scrollY")))
    (chromel--command "test-key-down" "k")
    (chromel-test--until (format "scrollY<%s" (- before 80)) "Immediate reversal did not keep scrolling"))
  (chromel--command "test-key-up" "j")
  (let ((before (chromel-test--js "scrollY")))
    (chromel-test--until (format "scrollY<%s" (- before 80)) "Old keyup cancelled the new direction"))
  (chromel--command "test-key-up" "k")
  (chromel-test--still "scrollY")
  ;; Selection loss stops a held key even if its keyup never reaches this view.
  (chromel--command "test-key-down" "j")
  (let ((before (chromel-test--js "scrollY")))
    (chromel-test--until (format "scrollY>%s" (+ before 100)) "Cancellation hold did not start"))
  (chromel--command "selected" "0")
  (chromel-test--still "scrollY")
  (chromel--command "test-key-up" "j")
  ;; Instant mode retains keyboard-repeat distances, without a runaway hold.
  (let ((chromel-scroll-duration 0) (before (chromel-test--js "scrollY")))
    (chromel--sync)
    (chromel--command "test-key-down" "j")
    (chromel-test--until (format "scrollY===%s" (+ before 60)) "Instant keydown failed")
    (chromel--command "test-key-repeat" "j")
    (chromel-test--until (format "scrollY===%s" (+ before 120)) "Instant repeat lost distance")
    (chromel--command "test-key-up" "j")
    (chromel-test--still "scrollY"))
  ;; Exercise reduced-motion behavior even on a machine without that setting.
  (chromel-test--js "(()=>{window.savedMatchMedia=window.matchMedia;window.matchMedia=q=>q==='(prefers-reduced-motion: reduce)'?{matches:true}:savedMatchMedia(q);return true})()")
  (chromel--sync)
  (let ((before (chromel-test--js "scrollY")))
    (chromel--command "test-key-down" "j")
    (chromel-test--until (format "scrollY===%s" (+ before 60)) "Reduced-motion keydown failed")
    (chromel--command "test-key-repeat" "j")
    (chromel-test--until (format "scrollY===%s" (+ before 120)) "Reduced-motion repeat failed")
    (chromel--command "test-key-up" "j")
    (chromel-test--still "scrollY"))
  (chromel-test--js "(window.matchMedia=window.savedMatchMedia,true)"))
(defun chromel-test--step ()
  (unless chromel-test--busy
    (let ((chromel-test--busy t))
      (with-current-buffer (if (buffer-live-p chromel-test--source) chromel-test--source (current-buffer))
        (condition-case err
            (progn
              (when (> (float-time) chromel-test--deadline) (error "Hold test timed out"))
              (pcase chromel-test--phase
                ('loading
                 (when (equal chromel--title "scroll-ready")
                   (switch-to-buffer chromel-test--source)
                   (delete-other-windows)
                   (chromel--sync)
                   (chromel-test--until "Boolean(frameState.same && frameState.cross && frameState.nested)" "Frames did not load")
                   (chromel-test--exercise)
                   (kill-buffer chromel-test--source)
                   (setq chromel-test--phase 'closing)))
                ('closing
                 (when (string-match-p "Browsers including DevTools: 0" (chromel--native-info))
                   (chromel-test--finish t (format "Physical hold/release: iframe routing, repeat independence, Meow dispatch/keymap override, selection cancellation, reversal, overlapping taps, instant/reduced-motion repeats; steady velocity %S CSS px/s" chromel-test--measurements))))))
          (error (chromel-test--finish nil (error-message-string err))))))))
(run-at-time 1 nil
             (lambda ()
               (condition-case err
                   (progn
                     (set-frame-size nil 1100 750 t)
                     (setq chromel-test--source (chromel (getenv "CHROMEL_TEST_URL")))
                     (run-at-time 0.2 0.2 #'chromel-test--step))
                 (error (chromel-test--finish nil (error-message-string err))))))
