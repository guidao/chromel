;;; chromel-session-test.el --- Session persistence and lazy tabs -*- lexical-binding: t; -*-
(require 'ert)
(require 'chromel)

(defmacro chromel-test--with-session (&rest body)
  (declare (indent 0))
  `(let ((chromel-data-directory (make-temp-file "chromel-session-test-" t))
         (chromel--pages (make-hash-table)) (chromel--tabs nil) (chromel--frames (make-hash-table))
         (chromel--initialized nil) (chromel--timer nil) (chromel--syncing nil)
         (chromel--closed-tabs nil) (chromel--last-selected-tab nil)
         (chromel--session-loaded nil) (chromel--previous-session nil) (chromel--session-restored nil)
         (chromel--session-backed-up nil) (chromel--session-active nil) (chromel--session-dirty nil)
         (chromel--session-timer nil) (chromel--session-inhibit nil) (chromel--shutting-down nil)
         (chromel--history-loaded nil) (chromel--history-timer nil)
         (chromel-session-auto-save t) (chromel-closed-tab-limit 30)
         (next-id 0) created commands)
     (cl-letf (((symbol-function 'chromel--start) (lambda () (chromel--session-load)))
               ((symbol-function 'chromel--frame-handle) (lambda (_) 1))
               ((symbol-function 'chromel--native-create)
                (lambda (_ url) (push url created) (cl-incf next-id)))
               ((symbol-function 'chromel--native-command) (lambda (&rest args) (push args commands)))
               ((symbol-function 'chromel--native-layout) #'ignore)
               ((symbol-function 'chromel--native-hide) #'ignore))
       (unwind-protect
           (save-window-excursion ,@body)
         (let ((chromel--session-inhibit t))
           (dolist (buffer (chromel--buffers)) (kill-buffer buffer)))
         (when (timerp chromel--session-timer) (cancel-timer chromel--session-timer))
         (delete-directory chromel-data-directory t)))))

(defun chromel-test--saved-session ()
  '(:version 1 :selected 1
    :tabs [(:url "https://one.example/中文?q=café" :title "中文 😀")
           (:url "https://two.example/" :title "Two")
           (:url "https://three.example/" :title "Three")]
    :closed [(:url "https://closed.example/" :title "Closed" :index 2)]))

(ert-deftest chromel-session-reopen-closed-order-and-deferred-close ()
  (chromel-test--with-session
    (chromel--session-load)
    (let* ((a (chromel--make-tab "https://a.example" "A"))
           (b (chromel--make-tab "https://b.example" "B"))
           (c (chromel--make-tab "https://c.example" "C")))
      (kill-buffer b) (kill-buffer c)
      (should-not commands) (should-not created)
      (should (= 2 (length chromel--closed-tabs)))
      (chromel-reopen-closed-tab)
      (chromel-reopen-closed-tab)
      (should (equal (mapcar (lambda (b) (buffer-local-value 'chromel--title b)) (chromel--buffers))
                     '("A" "B" "C")))
      (should (= 2 (length created)))
      (should (eq (car (chromel--buffers)) a))
      (should-not chromel--closed-tabs))))

(ert-deftest chromel-session-close-veto-and-mode-change ()
  (chromel-test--with-session
    (let ((buffer (chromel--make-tab "https://a.example" "A")))
      (with-current-buffer buffer
        (let ((kill-buffer-query-functions (list (lambda () nil))))
          (should-not (kill-buffer buffer))))
      (should-not chromel--closed-tabs)
      (with-current-buffer buffer (fundamental-mode))
      (should (= 1 (length chromel--closed-tabs)))
      (should-not (chromel--buffers))
      (kill-buffer buffer)
      (should (= 1 (length chromel--closed-tabs))))))

(ert-deftest chromel-session-reopen-failure-keeps-closed-entry ()
  (chromel-test--with-session
    (chromel--session-load)
    (kill-buffer (chromel--make-tab "https://a.example" "A"))
    (let ((before (copy-tree chromel--closed-tabs)))
      (cl-letf (((symbol-function 'chromel--native-create) (lambda (&rest _) (error "create failed"))))
        (should-error (chromel-reopen-closed-tab)))
      (should (equal before chromel--closed-tabs))
      (should-not (chromel--buffers))
      (chromel-reopen-closed-tab)
      (should (= 1 (length (chromel--buffers))))
      (should-not chromel--closed-tabs))))

(ert-deftest chromel-session-restore-appends-lazily-and-only-once ()
  (chromel-test--with-session
    (chromel--session-write "session.json" (chromel-test--saved-session))
    (let ((existing (chromel "https://existing.example" t)))
      ;; Saving a new page before restoration must not lose the previous run.
      (chromel-save-session)
      (let ((restored (chromel-restore-session)))
        (should (equal (chromel--buffers) (cons existing restored)))
        (should (eq (current-buffer) (nth 1 restored)))
        (should (= 2 (hash-table-count chromel--pages)))
        (should (buffer-local-value 'chromel--pending (car restored)))
        (should (buffer-local-value 'chromel--pending (nth 2 restored)))
        (should-error (chromel-restore-session) :type 'user-error)
        (should (= 4 (length (chromel--buffers))))
        (chromel--select-buffer (car restored))
        (chromel--select-buffer (car restored))
        (should (= 3 (length created)))
        (should (= 3 (hash-table-count chromel--pages)))
        ;; Plain Emacs buffer switching activates the remaining deferred tab.
        (switch-to-buffer (nth 2 restored))
        (let ((chromel--initialized t)) (chromel--sync))
        (should-not chromel--pending)
        (should (= 4 (length created)))
        (should (equal (chromel--session-read (expand-file-name "session.previous.json" chromel-data-directory))
                       (chromel-test--saved-session)))))))

(ert-deftest chromel-session-restore-failure-rolls-back-and-can-retry ()
  (chromel-test--with-session
    (chromel--session-write "session.json" (chromel-test--saved-session))
    (let ((original (chromel "https://existing.example")))
      (cl-letf (((symbol-function 'chromel--native-create) (lambda (&rest _) (error "create failed"))))
        (should-error (chromel-restore-session)))
      (should (equal (chromel--buffers) (list original)))
      (should (eq (current-buffer) original))
      (should-not chromel--session-restored)
      (should (= 1 (length chromel--closed-tabs)))
      (chromel-restore-session)
      (should (= 4 (length (chromel--buffers)))))))

(ert-deftest chromel-session-unicode-roundtrip-and-selected-ordinary-buffer ()
  (chromel-test--with-session
    (chromel--session-write "session.json" (chromel-test--saved-session))
    (chromel-restore-session)
    (with-temp-buffer
      (switch-to-buffer (current-buffer))
      (let ((coding-system-for-write 'iso-latin-1) (coding-system-for-read 'iso-latin-1))
        (cl-letf (((symbol-function 'read-coding-system) (lambda (&rest _) (ert-fail "Encoding prompt"))))
          (chromel-save-session)
          (should (equal (chromel--session-read (expand-file-name "session.json" chromel-data-directory))
                         (chromel-test--saved-session))))))
    (should (= #o600 (file-modes (expand-file-name "session.json" chromel-data-directory))))
    (should (= #o700 (file-modes chromel-data-directory)))))

(ert-deftest chromel-session-invalid-file-is-never-overwritten ()
  (dolist (text '("broken json" "{\"version\":99,\"tabs\":[],\"closed\":[],\"selected\":0}"
                  "{\"version\":1,\"tabs\":[],\"closed\":[],\"selected\":5}"))
    (chromel-test--with-session
      (let ((file (expand-file-name "session.json" chromel-data-directory)))
        (with-temp-file file (insert text))
        (chromel--session-load)
        (should (eq chromel--session-loaded 'failed))
        (chromel "https://usable.example" t)
        (should-error (chromel-save-session) :type 'user-error)
        (should-error (chromel-restore-session) :type 'user-error)
        (should-not chromel--session-timer)
        (should (equal text (with-temp-buffer (insert-file-contents file) (buffer-string))))))))

(ert-deftest chromel-session-exit-without-opening-preserves-previous-run ()
  (chromel-test--with-session
    (chromel--session-write "session.json" (chromel-test--saved-session))
    (chromel--session-load)
    (chromel--shutdown)
    (should (equal (chromel--session-read (expand-file-name "session.json" chromel-data-directory))
                   (chromel-test--saved-session)))))

(ert-deftest chromel-session-exit-flushes-latest-open-and-closed-pages ()
  (chromel-test--with-session
    (let ((a (chromel "https://a.example"))
          (b (chromel "https://b.example" t)))
      (kill-buffer b)
      (should (timerp chromel--session-timer))
      (chromel--shutdown)
      (should-not chromel--session-timer)
      (let ((saved (chromel--session-read (expand-file-name "session.json" chromel-data-directory))))
        (should (= 1 (length (plist-get saved :tabs))))
        (should (= 1 (length (plist-get saved :closed)))))
      (should (buffer-live-p a)))))

(ert-deftest chromel-session-atomic-write-failure-preserves-file-and-retries ()
  (chromel-test--with-session
    (chromel "https://a.example")
    (chromel-save-session)
    (let* ((file (expand-file-name "session.json" chromel-data-directory))
           (saved (chromel--session-read file)))
      (setq chromel--title "Changed")
      (chromel--session-changed)
      (cl-letf (((symbol-function 'rename-file) (lambda (&rest _) (error "disk failure"))))
        (should-error (chromel-save-session)))
      (should (equal saved (chromel--session-read file)))
      (should chromel--session-dirty)
      (should-not (directory-files chromel-data-directory nil "^\\.session-"))
      (chromel-save-session)
      (should (equal "Changed" (plist-get (aref (plist-get (chromel--session-read file) :tabs) 0) :title))))))

(ert-deftest chromel-session-deferred-activation-failure-does-not-retry-every-tick ()
  (chromel-test--with-session
    (let ((buffer (chromel--make-tab "https://a.example" "A")) (attempts 0))
      (switch-to-buffer buffer)
      (let ((chromel--initialized t))
        (cl-letf (((symbol-function 'chromel--native-create)
                   (lambda (&rest _) (cl-incf attempts) (error "create failed"))))
          (chromel--sync) (chromel--sync)
          (should (= attempts 1))
          (should chromel--pending)
          (should chromel--activation-error)))
      (chromel-reload)
      (should-not chromel--pending)
      (should-not chromel--activation-error))))

(ert-deftest chromel-session-autosave-optout-and-closed-stack-limit ()
  (chromel-test--with-session
    (let ((chromel-session-auto-save nil) (chromel-closed-tab-limit 1))
      (kill-buffer (chromel "https://a.example" t))
      (kill-buffer (chromel "https://b.example" t))
      (should (= 1 (length chromel--closed-tabs)))
      (should (equal "https://b.example" (plist-get (car chromel--closed-tabs) :url)))
      (should-not chromel--session-timer)
      (should-not (file-exists-p (expand-file-name "session.json" chromel-data-directory)))
      (chromel-save-session)
      (should (= 0 (length (plist-get (chromel--session-read (expand-file-name "session.json" chromel-data-directory)) :tabs)))))))
