;;; gui-management.el --- Chrome management routing regression -*- lexical-binding: t; -*-
(require 'chromel)
(setq chromel-data-directory (file-name-as-directory (getenv "CHROMEL_TEST_PROFILE")))
(defun chromel-test--assert (value text) (unless value (error "%s" text)))
(defun chromel-test--state () (json-parse-string (chromel--native-inspect 0) :object-type 'plist))
(defun chromel-test--wait (predicate text)
  (let ((deadline (+ (float-time) 8)) done)
    (while (and (not (setq done (funcall predicate))) (< (float-time) deadline))
      (accept-process-output nil 0.02))
    (chromel-test--assert done text)))
(defun chromel-test--settings-js (expression)
  (chromel--native-command 0 "test-settings-script" expression)
  (chromel-test--wait (lambda () (not (equal "" (plist-get (chromel-test--state) :testResult)))) "Settings script timeout")
  (let* ((state (chromel-test--state))
         (result (json-parse-string (plist-get state :testResult) :object-type 'plist)))
    (chromel-test--assert (and (eq t (plist-get state :testSuccess)) (not (plist-get result :exceptionDetails)))
                      (format "Settings script failed: %S" result))
    (plist-get (plist-get result :result) :value)))
(defun chromel-test--run ()
  (condition-case err
      (progn
        (chromel (getenv "CHROMEL_TEST_URL"))
        (chromel-test--wait (lambda () (string-prefix-p "chromel-emacs-" chromel--title)) "Fixture failed to load")
        (let ((id chromel--id) (url chromel--url))
          ;; A navigation originating in an embedded page must be handed off.
          (chromel--command "javascript" "location.href='https://chromewebstore.google.com/'")
          (chromel-test--wait (lambda () (string-prefix-p "https://chromewebstore.google.com" (plist-get (chromel-test--state) :url))) "Embedded store navigation was not routed")
          (chromel-test--assert (and (= id chromel--id) (equal url chromel--url) (= 1 (length (chromel--buffers)))) "Store replaced the embedded page")
          (chromel-extensions)
          (chromel-test--wait (lambda () (equal (plist-get (chromel-test--state) :title) "Extensions")) "Extension manager did not load")
          (chromel-test--assert (eq t (chromel-test--settings-js "!!document.querySelector('extensions-manager') && !!chrome.management")) "Native extension manager missing")
          (let ((manager-id (plist-get (chromel-test--state) :id)))
            (chromel-open-new-url "chrome://extensions/shortcuts")
            (chromel-test--wait (lambda () (equal (plist-get (chromel-test--state) :url) "chrome://extensions/shortcuts")) "Extension shortcuts did not open")
            (chromel-test--assert (= manager-id (plist-get (chromel-test--state) :id)) "Manager was duplicated"))
          (chromel-test--assert (= 1 (length (chromel--buffers))) "Manager created an Emacs tab"))
        (with-temp-file (getenv "CHROMEL_TEST_RESULT")
          (insert "PASS: embedded store handoff, extension WebUI, shared window, shortcuts and source buffer preservation\n"))
        (kill-emacs 0))
    (error
     (with-temp-file (getenv "CHROMEL_TEST_RESULT") (insert (format "FAIL: %S\n" err)))
     (kill-emacs 1))))
(run-at-time 0.1 nil #'chromel-test--run)
