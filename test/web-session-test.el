;;; web-session-test.el --- Session persistence and lazy tabs -*- lexical-binding: t; -*-
(require 'ert)
(require 'web)

(defmacro web-test--with-session (&rest body)
  (declare (indent 0))
  `(let ((web-data-directory (make-temp-file "web-session-test-" t))
         (web--pages (make-hash-table)) (web--tabs nil) (web--frames (make-hash-table))
         (web--initialized nil) (web--timer nil) (web--syncing nil)
         (web--closed-tabs nil) (web--last-selected-tab nil)
         (web--session-loaded nil) (web--previous-session nil) (web--session-restored nil)
         (web--session-backed-up nil) (web--session-active nil) (web--session-dirty nil)
         (web--session-timer nil) (web--session-inhibit nil) (web--shutting-down nil)
         (web--history-loaded nil) (web--history-timer nil)
         (web-session-auto-save t) (web-closed-tab-limit 30)
         (next-id 0) created commands)
     (cl-letf (((symbol-function 'web--start) (lambda () (web--session-load)))
               ((symbol-function 'web--frame-handle) (lambda (_) 1))
               ((symbol-function 'web--native-create)
                (lambda (_ url) (push url created) (cl-incf next-id)))
               ((symbol-function 'web--native-command) (lambda (&rest args) (push args commands)))
               ((symbol-function 'web--native-layout) #'ignore)
               ((symbol-function 'web--native-hide) #'ignore))
       (unwind-protect
           (save-window-excursion ,@body)
         (let ((web--session-inhibit t))
           (dolist (buffer (web--buffers)) (kill-buffer buffer)))
         (when (timerp web--session-timer) (cancel-timer web--session-timer))
         (delete-directory web-data-directory t)))))

(defun web-test--saved-session ()
  '(:version 1 :selected 1
    :tabs [(:url "https://one.example/中文?q=café" :title "中文 😀")
           (:url "https://two.example/" :title "Two")
           (:url "https://three.example/" :title "Three")]
    :closed [(:url "https://closed.example/" :title "Closed" :index 2)]))

(ert-deftest web-session-reopen-closed-order-and-deferred-close ()
  (web-test--with-session
    (web--session-load)
    (let* ((a (web--make-tab "https://a.example" "A"))
           (b (web--make-tab "https://b.example" "B"))
           (c (web--make-tab "https://c.example" "C")))
      (kill-buffer b) (kill-buffer c)
      (should-not commands) (should-not created)
      (should (= 2 (length web--closed-tabs)))
      (web-reopen-closed-tab)
      (web-reopen-closed-tab)
      (should (equal (mapcar (lambda (b) (buffer-local-value 'web--title b)) (web--buffers))
                     '("A" "B" "C")))
      (should (= 2 (length created)))
      (should (eq (car (web--buffers)) a))
      (should-not web--closed-tabs))))

(ert-deftest web-session-close-veto-and-mode-change ()
  (web-test--with-session
    (let ((buffer (web--make-tab "https://a.example" "A")))
      (with-current-buffer buffer
        (let ((kill-buffer-query-functions (list (lambda () nil))))
          (should-not (kill-buffer buffer))))
      (should-not web--closed-tabs)
      (with-current-buffer buffer (fundamental-mode))
      (should (= 1 (length web--closed-tabs)))
      (should-not (web--buffers))
      (kill-buffer buffer)
      (should (= 1 (length web--closed-tabs))))))

(ert-deftest web-session-reopen-failure-keeps-closed-entry ()
  (web-test--with-session
    (web--session-load)
    (kill-buffer (web--make-tab "https://a.example" "A"))
    (let ((before (copy-tree web--closed-tabs)))
      (cl-letf (((symbol-function 'web--native-create) (lambda (&rest _) (error "create failed"))))
        (should-error (web-reopen-closed-tab)))
      (should (equal before web--closed-tabs))
      (should-not (web--buffers))
      (web-reopen-closed-tab)
      (should (= 1 (length (web--buffers))))
      (should-not web--closed-tabs))))

(ert-deftest web-session-restore-appends-lazily-and-only-once ()
  (web-test--with-session
    (web--session-write "session.json" (web-test--saved-session))
    (let ((existing (web "https://existing.example" t)))
      ;; Saving a new page before restoration must not lose the previous run.
      (web-save-session)
      (let ((restored (web-restore-session)))
        (should (equal (web--buffers) (cons existing restored)))
        (should (eq (current-buffer) (nth 1 restored)))
        (should (= 2 (hash-table-count web--pages)))
        (should (buffer-local-value 'web--pending (car restored)))
        (should (buffer-local-value 'web--pending (nth 2 restored)))
        (should-error (web-restore-session) :type 'user-error)
        (should (= 4 (length (web--buffers))))
        (web--select-buffer (car restored))
        (web--select-buffer (car restored))
        (should (= 3 (length created)))
        (should (= 3 (hash-table-count web--pages)))
        ;; Plain Emacs buffer switching activates the remaining deferred tab.
        (switch-to-buffer (nth 2 restored))
        (let ((web--initialized t)) (web--sync))
        (should-not web--pending)
        (should (= 4 (length created)))
        (should (equal (web--session-read (expand-file-name "session.previous.json" web-data-directory))
                       (web-test--saved-session)))))))

(ert-deftest web-session-restore-failure-rolls-back-and-can-retry ()
  (web-test--with-session
    (web--session-write "session.json" (web-test--saved-session))
    (let ((original (web "https://existing.example")))
      (cl-letf (((symbol-function 'web--native-create) (lambda (&rest _) (error "create failed"))))
        (should-error (web-restore-session)))
      (should (equal (web--buffers) (list original)))
      (should (eq (current-buffer) original))
      (should-not web--session-restored)
      (should (= 1 (length web--closed-tabs)))
      (web-restore-session)
      (should (= 4 (length (web--buffers)))))))

(ert-deftest web-session-unicode-roundtrip-and-selected-ordinary-buffer ()
  (web-test--with-session
    (web--session-write "session.json" (web-test--saved-session))
    (web-restore-session)
    (with-temp-buffer
      (switch-to-buffer (current-buffer))
      (let ((coding-system-for-write 'iso-latin-1) (coding-system-for-read 'iso-latin-1))
        (cl-letf (((symbol-function 'read-coding-system) (lambda (&rest _) (ert-fail "Encoding prompt"))))
          (web-save-session)
          (should (equal (web--session-read (expand-file-name "session.json" web-data-directory))
                         (web-test--saved-session))))))
    (should (= #o600 (file-modes (expand-file-name "session.json" web-data-directory))))
    (should (= #o700 (file-modes web-data-directory)))))

(ert-deftest web-session-invalid-file-is-never-overwritten ()
  (dolist (text '("broken json" "{\"version\":99,\"tabs\":[],\"closed\":[],\"selected\":0}"
                  "{\"version\":1,\"tabs\":[],\"closed\":[],\"selected\":5}"))
    (web-test--with-session
      (let ((file (expand-file-name "session.json" web-data-directory)))
        (with-temp-file file (insert text))
        (web--session-load)
        (should (eq web--session-loaded 'failed))
        (web "https://usable.example" t)
        (should-error (web-save-session) :type 'user-error)
        (should-error (web-restore-session) :type 'user-error)
        (should-not web--session-timer)
        (should (equal text (with-temp-buffer (insert-file-contents file) (buffer-string))))))))

(ert-deftest web-session-exit-without-opening-preserves-previous-run ()
  (web-test--with-session
    (web--session-write "session.json" (web-test--saved-session))
    (web--session-load)
    (web--shutdown)
    (should (equal (web--session-read (expand-file-name "session.json" web-data-directory))
                   (web-test--saved-session)))))

(ert-deftest web-session-exit-flushes-latest-open-and-closed-pages ()
  (web-test--with-session
    (let ((a (web "https://a.example"))
          (b (web "https://b.example" t)))
      (kill-buffer b)
      (should (timerp web--session-timer))
      (web--shutdown)
      (should-not web--session-timer)
      (let ((saved (web--session-read (expand-file-name "session.json" web-data-directory))))
        (should (= 1 (length (plist-get saved :tabs))))
        (should (= 1 (length (plist-get saved :closed)))))
      (should (buffer-live-p a)))))

(ert-deftest web-session-atomic-write-failure-preserves-file-and-retries ()
  (web-test--with-session
    (web "https://a.example")
    (web-save-session)
    (let* ((file (expand-file-name "session.json" web-data-directory))
           (saved (web--session-read file)))
      (setq web--title "Changed")
      (web--session-changed)
      (cl-letf (((symbol-function 'rename-file) (lambda (&rest _) (error "disk failure"))))
        (should-error (web-save-session)))
      (should (equal saved (web--session-read file)))
      (should web--session-dirty)
      (should-not (directory-files web-data-directory nil "^\\.session-"))
      (web-save-session)
      (should (equal "Changed" (plist-get (aref (plist-get (web--session-read file) :tabs) 0) :title))))))

(ert-deftest web-session-deferred-activation-failure-does-not-retry-every-tick ()
  (web-test--with-session
    (let ((buffer (web--make-tab "https://a.example" "A")) (attempts 0))
      (switch-to-buffer buffer)
      (let ((web--initialized t))
        (cl-letf (((symbol-function 'web--native-create)
                   (lambda (&rest _) (cl-incf attempts) (error "create failed"))))
          (web--sync) (web--sync)
          (should (= attempts 1))
          (should web--pending)
          (should web--activation-error)))
      (web-reload)
      (should-not web--pending)
      (should-not web--activation-error))))

(ert-deftest web-session-autosave-optout-and-closed-stack-limit ()
  (web-test--with-session
    (let ((web-session-auto-save nil) (web-closed-tab-limit 1))
      (kill-buffer (web "https://a.example" t))
      (kill-buffer (web "https://b.example" t))
      (should (= 1 (length web--closed-tabs)))
      (should (equal "https://b.example" (plist-get (car web--closed-tabs) :url)))
      (should-not web--session-timer)
      (should-not (file-exists-p (expand-file-name "session.json" web-data-directory)))
      (web-save-session)
      (should (= 0 (length (plist-get (web--session-read (expand-file-name "session.json" web-data-directory)) :tabs)))))))
