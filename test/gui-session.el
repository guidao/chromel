;;; gui-session.el --- Persist and restore across independent GUI processes -*- lexical-binding: t; -*-
(require 'chromel)
(setq chromel-data-directory (file-name-as-directory (getenv "CHROMEL_TEST_PROFILE")))
(defvar chromel-test--tabs nil)
(defvar chromel-test--busy nil)
(defvar chromel-test--phase 'loading)
(defvar chromel-test--deadline (+ (float-time) 45))
(defvar chromel-test--restore (equal (getenv "CHROMEL_TEST_SESSION_PHASE") "restore"))
(defun chromel-test--assert (value text) (unless value (error "%s" text)))
(defun chromel-test--finish (ok text)
  (with-temp-file (getenv "CHROMEL_TEST_RESULT") (insert (if ok "PASS: " "FAIL: ") text "\n"))
  (kill-emacs (if ok 0 1)))
(defun chromel-test--loaded (buffer)
  (and (buffer-live-p buffer) (buffer-local-value 'chromel--id buffer)
       (string-prefix-p "chromel-emacs-" (buffer-local-value 'chromel--title buffer))
       (equal "" (buffer-local-value 'chromel--status buffer))))
(defun chromel-test--urls () (mapcar (lambda (b) (buffer-local-value 'chromel--url b)) (chromel--buffers)))
(defun chromel-test--step ()
  (unless chromel-test--busy
    (let ((chromel-test--busy t))
      (with-current-buffer (window-buffer (selected-window))
        (condition-case err
            (progn
              (when (> (float-time) chromel-test--deadline) (error "Session GUI timed out"))
              (pcase chromel-test--phase
                ('loading
                 (if chromel-test--restore
                     (when (chromel-test--loaded (nth 1 chromel-test--tabs))
                       (chromel-test--assert (= 1 (hash-table-count chromel--pages)) "Restore created background browsers")
                       (chromel-test--assert (eq (window-buffer (selected-window)) (nth 1 chromel-test--tabs)) "Saved selected page lost")
                       (chromel-test--assert (equal (buffer-local-value 'chromel--title (nth 2 chromel-test--tabs)) "会话三 😀") "Deferred title not restored")
                       (chromel-test--assert (equal (chromel-test--urls)
                                                (list (getenv "CHROMEL_TEST_URL")
                                                      (concat (getenv "CHROMEL_TEST_URL") "?session=two")
                                                      (concat (getenv "CHROMEL_TEST_URL") "?session=three"))) "Tab order or URLs lost")
                       (chromel-test--assert (eq t (chromel--eval "JSON.stringify(localStorage.getItem('chromel-test')==='saved' && document.cookie.includes('chromel-test=saved'))")) "Restored page did not share existing profile")
                       (let (rejected)
                         (condition-case nil (chromel-restore-session) (user-error (setq rejected t)))
                         (chromel-test--assert rejected "Restored the same session twice"))
                       ;; This is an ordinary Emacs buffer switch, not our tab command.
                       (switch-to-buffer (nth 2 chromel-test--tabs))
                       (setq chromel-test--phase 'activated))
                   (when (cl-every #'chromel-test--loaded chromel-test--tabs)
                     (with-current-buffer (nth 2 chromel-test--tabs)
                       (chromel--eval "JSON.stringify((document.title='会话三 😀',true))"))
                     (chromel--select-buffer (nth 1 chromel-test--tabs))
                     (kill-buffer (nth 3 chromel-test--tabs))
                     (execute-kbd-macro (kbd "X"))
                     (chromel-test--assert (string-suffix-p "?session=closed" chromel--url) "X did not restore closed page")
                     (chromel-test--assert (eq (current-buffer) (nth 3 (chromel--buffers))) "X restored at wrong position")
                     (execute-kbd-macro (kbd "x"))
                     (chromel--select-buffer (nth 1 chromel-test--tabs))
                     (setq chromel-test--phase 'saved))))
                ('saved
                 ;; Check the autosaved file BEFORE kill-emacs can flush it.
                 (let ((file (expand-file-name "session.json" chromel-data-directory)))
                   (when (and (file-exists-p file) (not chromel--session-dirty)
                              (equal (buffer-local-value 'chromel--title (nth 2 chromel-test--tabs)) "会话三 😀"))
                     (let ((saved (chromel--session-read file)))
                       (chromel-test--assert (= 3 (length (plist-get saved :tabs))) "Autosave omitted open tabs")
                       (chromel-test--assert (= 1 (plist-get saved :selected)) "Autosave lost selected tab")
                       (chromel-test--assert (string-suffix-p "?session=closed" (plist-get (aref (plist-get saved :closed) 0) :url)) "Closed history not persisted")
                       (chromel-test--finish t "Session seed: real X/x restores original position; autosave contains ordered tabs, Unicode title, selection and closed history")))))
                ('activated
                 (when (chromel-test--loaded (nth 2 chromel-test--tabs))
                   (chromel-test--assert (= 2 (hash-table-count chromel--pages)) "Switching a deferred tab created extra browsers")
                   (chromel-test--assert (buffer-local-value 'chromel--pending (car chromel-test--tabs)) "Unselected deferred tab was loaded")
                   (kill-buffer (car chromel-test--tabs))
                   (chromel-test--assert (= 2 (hash-table-count chromel--pages)) "Closing a deferred tab created a browser")
                   (execute-kbd-macro (kbd "X"))
                   (chromel-test--assert (eq (current-buffer) (car (chromel--buffers))) "X lost deferred tab's position")
                   (chromel-test--assert (= 3 (hash-table-count chromel--pages)) "X did not materialize exactly one browser")
                   (setq chromel-test--phase 'reopened)))
                ('reopened
                 (when (chromel-test--loaded (car (chromel--buffers)))
                   (chromel-test--assert (eq :false (plist-get (json-parse-string (chromel--native-inspect chromel--id) :object-type 'plist) :focused)) "X stole Emacs command focus")
                   (chromel-test--finish t "Session restore: separate process, one initial browser, lazy activation via normal buffer switch, deferred close/X, saved order/selection/profile and no duplicates")))))
          (error (chromel-test--finish nil (format "%s (phase %s)" (error-message-string err) chromel-test--phase))))))))
(run-at-time 1 nil
             (lambda ()
               (condition-case err
                   (progn
                     (if chromel-test--restore
                         (setq chromel-test--tabs (chromel-restore-session))
                       (setq chromel-test--tabs
                             (list (chromel (getenv "CHROMEL_TEST_URL"))
                                   (chromel (concat (getenv "CHROMEL_TEST_URL") "?session=two") t)
                                   (chromel (concat (getenv "CHROMEL_TEST_URL") "?session=three") t)
                                   (chromel (concat (getenv "CHROMEL_TEST_URL") "?session=closed") t))
                             chromel--closed-tabs nil))
                     (run-at-time 0.1 0.1 #'chromel-test--step))
                 (error (chromel-test--finish nil (error-message-string err))))))
