;;; gui-settings.el --- Shared-profile Chrome settings regression -*- lexical-binding: t; -*-
(require 'web)
(setq web-data-directory (file-name-as-directory (getenv "WEB_TEST_PROFILE")))
(defun web-test--assert (value text) (unless value (error "%s" text)))
(defun web-test--state () (json-parse-string (web--native-inspect 0) :object-type 'plist))
(defun web-test--wait (predicate text)
  (let ((deadline (+ (float-time) 8)) done)
    (while (and (not (setq done (funcall predicate))) (< (float-time) deadline))
      (accept-process-output nil 0.02))
    (web-test--assert done text)))
(defun web-test--settings-js (expression)
  (web--native-command 0 "test-settings-script" expression)
  (web-test--wait (lambda () (not (equal "" (plist-get (web-test--state) :testResult)))) "Settings script timeout")
  (let* ((state (web-test--state))
         (result (json-parse-string (plist-get state :testResult) :object-type 'plist)))
    (web-test--assert (and (eq t (plist-get state :testSuccess)) (not (plist-get result :exceptionDetails)))
                      (format "Settings script failed: %S" result))
    (plist-get (plist-get result :result) :value)))
(defun web-test--font ()
  (web--eval "JSON.stringify(getComputedStyle(document.getElementById('settings-font')).fontSize)"))
(defun web-test--run ()
  (condition-case err
      (progn
        (message "Settings test: open/raise")
        (web-settings)
        (web-test--assert (null (web--buffers)) "Opening settings created an Emacs tab")
        (web-test--wait (lambda () (not (equal "" (plist-get (web-test--state) :title)))) "Settings failed to load")
        (web-test--assert (eq t (web-test--settings-js "!!document.querySelector('settings-ui')")) "Settings WebUI missing")
        (let ((state (web-test--state)))
          (web-test--assert (and (eq t (plist-get state :chrome)) (eq t (plist-get state :sharedContext))) "Wrong runtime/context")
          (web-open-new-url "chrome://settings/fonts")
          (web-test--wait (lambda () (equal (plist-get (web-test--state) :url) "chrome://settings/fonts")) "Subpage failed")
          (message "Settings test: open/raise")
        (web-settings)
          (web-test--assert (= (plist-get state :id) (plist-get (web-test--state) :id)) "Settings was duplicated")
          (web-test--assert (equal (plist-get (web-test--state) :url) "chrome://settings/fonts") "Raising window reset subpage")
          (web (getenv "WEB_TEST_URL"))
          (web-test--wait (lambda () (string-prefix-p "web-emacs-" web--title)) "Embedded page failed to load")
          (web-test--assert (/= (plist-get state :window)
                               (plist-get (json-parse-string (web--native-inspect web--id) :object-type 'plist) :window)) "Settings is not a separate window"))
        (web--eval "JSON.stringify((()=>{const d=document.createElement('div');d.id='settings-font';d.style.fontSize='medium';d.textContent='Settings font probe';document.body.append(d);return true})())")
        (if (equal (getenv "WEB_TEST_SETTINGS_PHASE") "seed")
            (progn
              (web-test--assert (not (equal (web-test--font) "24px")) "Font already changed before test")
              (web-test--assert
               (eq t (web-test--settings-js "new Promise(resolve=>chrome.settingsPrivate.setPref('webkit.webprefs.default_font_size',24,'',resolve))"))
               "Settings API rejected font preference"))
          (web-test--assert (= 24 (web-test--settings-js "new Promise(resolve=>chrome.settingsPrivate.getPref('webkit.webprefs.default_font_size',p=>resolve(p.value)))"))
                            "Settings preference not persisted"))
        (web-test--wait (lambda () (equal (web-test--font) "24px")) "Settings font did not affect embedded page")
        (message "Settings test: native window close")
        (web--native-command 0 "test-settings-close-window" "")
        (web-test--wait (lambda () (let ((state (web-test--state)))
                                  (and (= 0 (plist-get state :count))
                                       (eq :false (plist-get state :windowAlive))))) "Settings window failed to close")
        (web-test--assert (equal (web-test--font) "24px") "Closing settings damaged embedded page")
        (message "Settings test: open/raise")
        (web-settings)
        (web-test--wait (lambda () (not (equal "" (plist-get (web-test--state) :title)))) "Settings failed to reopen")
        (web-test--assert (= 1 (length (web--buffers))) "Settings entered tab list")
        (message "Settings test: close last embedded tab")
        (kill-buffer (current-buffer))
        (web-test--assert (and (null (web--buffers))
                              (= 1 (plist-get (web-test--state) :count)))
                          "Closing the last tab closed settings")
        ;; Keep the settings window open: kill-emacs must close it and flush prefs.
        (with-temp-file (getenv "WEB_TEST_RESULT")
          (insert "PASS: Chrome settings, reuse, shared font preference, persistence and independent lifecycle\n"))
        (message "Settings test: exiting Emacs")
        (kill-emacs 0))
    (error
     (with-temp-file (getenv "WEB_TEST_RESULT") (insert (format "FAIL: %S\n" err)))
     (kill-emacs 1))))
(run-at-time 0.1 nil #'web-test--run)
