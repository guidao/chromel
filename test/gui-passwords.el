;;; gui-passwords.el --- Chromium password autofill regression -*- lexical-binding: t; -*-
(require 'chromel)
(setq chromel-data-directory (file-name-as-directory (getenv "CHROMEL_TEST_PROFILE")))
(defun chromel-test--assert (value text) (unless value (error "%s" text)))
(defun chromel-test--state () (json-parse-string (chromel--native-inspect 0) :object-type 'plist))
(defun chromel-test--wait (predicate text)
  (let ((deadline (+ (float-time) 8)) done)
    (while (and (not (setq done (funcall predicate))) (< (float-time) deadline))
      (accept-process-output nil 0.03))
    (chromel-test--assert done text)))
(defun chromel-test--settings-js (expression)
  (chromel--native-command 0 "test-settings-script" expression)
  (chromel-test--wait (lambda () (not (equal "" (plist-get (chromel-test--state) :testResult)))) "Password manager script timeout")
  (let* ((state (chromel-test--state))
         (result (json-parse-string (plist-get state :testResult) :object-type 'plist)))
    (chromel-test--assert (and (eq t (plist-get state :testSuccess)) (not (plist-get result :exceptionDetails)))
                      "Password manager script failed")
    (plist-get (plist-get result :result) :value)))
(defun chromel-test--fields ()
  ;; Only test known dummy values. Never assign DOM input values: Chromium fills them.
  (chromel--eval "JSON.stringify({user:document.querySelector('#username').value==='chromel-test-user',password:document.querySelector('#password').value==='chromel-test-password-123',autofill:document.querySelector('#password').matches(':-webkit-autofill'),empty:!document.querySelector('#username').value&&!document.querySelector('#password').value})"))
(defun chromel-test--click-username ()
  ;; A trusted CEF mouse event unlocks Chromium's user-gesture-gated fill.
  (chromel--command "click" (chromel--json (chromel--eval "JSON.stringify((()=>{const r=document.querySelector('#username').getBoundingClientRect();return {x:r.x+10,y:r.y+10,newBuffer:false}})())"))))
(defun chromel-test--run ()
  (condition-case err
      (progn
        (chromel-passwords)
        (chromel-test--wait (lambda () (equal (plist-get (chromel-test--state) :title) "Password Manager")) "Password manager failed to load")
        (chromel-test--assert (eq t (chromel-test--settings-js "!!chrome.passwordsPrivate")) "Password WebUI API unavailable")
        (let ((state (chromel-test--state)))
          (chromel-test--assert (and (eq t (plist-get state :chrome)) (eq t (plist-get state :sharedContext))) "Wrong runtime or profile")
          (chromel-passwords)
          (chromel-test--assert (= (plist-get state :id) (plist-get (chromel-test--state) :id)) "Password manager duplicated"))
        (when (equal (getenv "CHROMEL_TEST_PASSWORD_PHASE") "seed")
          (chromel-test--assert
           (eq t (chromel-test--settings-js
                  (format "new Promise(resolve=>chrome.passwordsPrivate.addPassword({url:%s,username:'chromel-test-user',password:'chromel-test-password-123',note:'disposable regression fixture',useAccountStore:false},()=>resolve(!chrome.runtime.lastError)))"
                          (json-encode-string (getenv "CHROMEL_TEST_URL"))))) "Failed to add dummy password"))
        (chromel-test--assert
         (= 1 (chromel-test--settings-js "new Promise(resolve=>chrome.passwordsPrivate.getSavedPasswordList(list=>resolve(list.filter(p=>p.username==='chromel-test-user').length)))"))
         "Saved credential missing or duplicated")
        (chromel--native-command 0 "close-settings" "")
        (chromel-test--wait (lambda () (eq :false (plist-get (chromel-test--state) :windowAlive))) "Password manager failed to close")
        (chromel (getenv "CHROMEL_TEST_URL"))
        (chromel-test--wait (lambda () (equal chromel--title "password-test")) "Login fixture did not load")
        (chromel-test--wait (lambda () (eq t (plist-get (chromel-test--fields) :autofill))) "Chromium did not recognize saved credentials")
        (chromel-test--click-username)
        (chromel-test--wait (lambda () (let ((fields (chromel-test--fields)))
                                    (and (eq t (plist-get fields :user)) (eq t (plist-get fields :password)))))
                        "Chromium did not fill username/password after trusted click")
        ;; A different hostname must not receive this credential, even with a click.
        (chromel (replace-regexp-in-string "127.0.0.1" "localhost" (getenv "CHROMEL_TEST_URL") t t))
        (chromel-test--wait (lambda () (equal chromel--title "password-test")) "Other host did not load")
        (accept-process-output nil 1)
        (chromel-test--click-username)
        (accept-process-output nil 0.5)
        (let ((fields (chromel-test--fields)))
          (chromel-test--assert (and (eq t (plist-get fields :empty)) (eq :false (plist-get fields :autofill)))
                            "Credentials leaked to another hostname"))
        (with-temp-file (getenv "CHROMEL_TEST_RESULT")
          (insert "PASS: native password store, embedded Chromium autofill after trusted click, manager closed, cross-host isolation\n"))
        (kill-emacs 0))
    (error
     (with-temp-file (getenv "CHROMEL_TEST_RESULT") (insert (format "FAIL: %S\n" err)))
     (kill-emacs 1))))
(run-at-time 0.1 nil #'chromel-test--run)
