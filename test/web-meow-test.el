;;; web-meow-test.el --- Optional integration with the real Meow package -*- lexical-binding: t; -*-
(require 'ert)
(require 'meow)
(meow-motion-define-key '("j" . meow-next) '("k" . meow-prev))
(defconst web-test--original-motion-map (copy-keymap meow-motion-state-keymap))
(require 'web)
(meow-global-mode 1)

(ert-deftest web-meow-motion-keeps-keypad-and-browser-keys ()
  (with-temp-buffer
    (web-mode)
    (meow-mode 1)
    (should (eq meow--current-state 'motion))
    (should (equal meow-motion-state-keymap web-test--original-motion-map))
    (should (eq (key-binding (kbd "SPC")) 'meow-keypad))
    (should (equal (lookup-key key-translation-map [escape]) (kbd "C-g")))
    (dolist (pair '(("j" . web-scroll-down) ("k" . web-scroll-up)
                    ("gg" . web-scroll-to-top) ("G" . web-scroll-to-bottom)
                    ("r" . web-reload) ("H" . web-back) ("L" . web-forward)
                    ("f" . web-follow) ("F" . web-follow-background)
                    ("/" . web-find) ("n" . web-find-next) ("N" . web-find-previous)
                    ("yy" . web-copy-url) ("yf" . web-copy-link)
                    ("d" . web-scroll-half-page-down) ("u" . web-scroll-half-page-up)
                    ("o" . web-open) ("O" . web-open-new-url)
                    ("ge" . web-open-url) ("gE" . web-edit-url-new-buffer)
                    ("t" . web-new-tab) ("x" . web-close-tab) ("X" . web-reopen-closed-tab)
                    ("C-c w ," . web-settings) ("C-c w S" . web-save-session) ("C-c w R" . web-restore-session)
                    ("J" . web-previous-tab) ("K" . web-next-tab)
                    ("gT" . web-previous-tab) ("gt" . web-next-tab)
                    ("T" . web-switch-tab) ("^" . web-last-tab)
                    ("p" . web-open-copied-url) ("P" . web-open-copied-url-new-buffer)
                    ("gF" . web-focus-main-frame) ("C-c w h" . web-history)))
      (should (eq (key-binding (kbd (car pair))) (cdr pair))))))

(ert-deftest web-meow-other-buffers-unchanged ()
  (with-temp-buffer
    (special-mode)
    (meow-mode 1)
    (should (eq meow--current-state 'motion))
    (should (eq (key-binding "j") 'meow-next))
    (should (eq (key-binding "k") 'meow-prev))
    (should (eq (key-binding (kbd "SPC")) 'meow-keypad))
    (should (eq (key-binding [escape]) 'meow-last-buffer))))
