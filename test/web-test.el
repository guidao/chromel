(ert-deftest web-find-cancel-clears-highlights-and-keeps-last-query ()
  (with-temp-buffer
    (let ((web--id 7) (web--find-active t) (web--find-text "previous")
          (web--find-status " Find 2/3") commands)
      (cl-letf (((symbol-function 'read-from-minibuffer) (lambda (&rest _) (signal 'quit nil)))
                ((symbol-function 'web--command) (lambda (&rest args) (push args commands))))
        (should (eq 'cancelled (condition-case nil (web-find) (quit 'cancelled))))
        (should (assoc "find-stop" commands))
        (should-not web--find-active)
        (should (equal web--find-status ""))
        (should (equal web--find-text "previous"))))))

(ert-deftest web-find-late-result-does-not-complete-current-query ()
  (let ((web--pages (make-hash-table)))
    (with-temp-buffer
      (puthash 7 (current-buffer) web--pages)
      (setq-local web--find-token "new")
      (web--handle-event (list :id 7 :type "find" :value
                              (web--json '(:token "old" :count 20 :ordinal 10 :final t))))
      (should-not web--find-reply)
      (should (= web--find-count 0))
      (web--handle-event (list :id 7 :type "find" :value
                              (web--json '(:token "new" :count 3 :ordinal 1 :final :false))))
      (should-not web--find-reply)
      (web--handle-event (list :id 7 :type "find" :value
                              (web--json '(:token "new" :count -1 :ordinal 2 :final t))))
      (should (= web--find-count 3))
      (should (= web--find-ordinal 2))
      (should web--find-reply))))

(ert-deftest web-copy-link-revalidates-and-does-not-copy-stale-url ()
  (with-temp-buffer
    (let ((web--id 7) (calls 0) commands copied)
      (cl-letf (((symbol-function 'web--command) (lambda (&rest args) (push args commands)))
                ((symbol-function 'web--eval)
                 (lambda (_) (if (= 1 (cl-incf calls)) '((:label "a" :url "https://old.example")) :null)))
                ((symbol-function 'web--read-hint) (lambda (hints _) (car hints)))
                ((symbol-function 'kill-new) (lambda (&rest _) (setq copied t))))
        (should-error (web-copy-link) :type 'user-error)
        (should-not copied)
        (should-not (assoc "click" commands))
        (should (assoc "javascript" commands))))))

(ert-deftest web-hints-background-preserves-source-and-uses-command-click ()
  (with-temp-buffer
    (let ((web--id 7) (requests 0) commands (source (current-buffer)))
      (cl-letf (((symbol-function 'web--command) (lambda (&rest args) (push args commands)))
                ((symbol-function 'web--eval)
                 (lambda (_) (if (= 1 (cl-incf requests)) '((:label "a"))
                               '(:action "click" :x 10 :y 20 :link t))))
                ((symbol-function 'web--read-hint) (lambda (hints _) (car hints))))
        (web-follow-background)
        (let ((click (json-parse-string (cadr (assoc "click" commands)) :object-type 'plist)))
          (should (eq t (plist-get click :newBuffer)))
          (should (eq t (plist-get click :background))))
        (should (eq source (current-buffer)))))))

(ert-deftest web-tab-order-wrap-mru-and-close ()
  (let ((web--pages (make-hash-table)) buffers)
    (unwind-protect
        (save-window-excursion
          (dotimes (_ 3)
            (let ((buffer (generate-new-buffer " web-tab-test")))
              (push buffer buffers)
              (with-current-buffer buffer (web-mode))))
          (setq buffers (nreverse buffers))
          ;; Deliberately insert out of creation order; MRU must not affect gt.
          (puthash 30 (nth 2 buffers) web--pages)
          (puthash 10 (nth 0 buffers) web--pages)
          (puthash 20 (nth 1 buffers) web--pages)
          (cl-letf (((symbol-function 'web--command) #'ignore))
            (switch-to-buffer (nth 0 buffers))
            (web-next-tab) (should (eq (current-buffer) (nth 1 buffers)))
            (web-next-tab) (should (eq (current-buffer) (nth 2 buffers)))
            (web-next-tab) (should (eq (current-buffer) (nth 0 buffers)))
            (web-previous-tab) (should (eq (current-buffer) (nth 2 buffers)))
            (web-last-tab) (should (eq (current-buffer) (nth 0 buffers)))
            (web-last-tab) (should (eq (current-buffer) (nth 2 buffers)))
            (web-next-tab 5) (should (eq (current-buffer) (nth 1 buffers)))
            ;; A vetoed close must leave both buffer and selection intact.
            (let ((kill-buffer-query-functions (list (lambda () nil))))
              (web-close-tab))
            (should (eq (current-buffer) (nth 1 buffers)))
            (should (buffer-live-p (nth 1 buffers)))
            (web-close-tab)
            (should-not (buffer-live-p (nth 1 buffers)))
            (should (eq (current-buffer) (nth 2 buffers)))
            (web-close-tab)
            (should (eq (current-buffer) (nth 0 buffers)))
            (should-error (web-last-tab) :type 'user-error)
            (web-close-tab)
            (should-not (web--buffers))))
      (dolist (buffer buffers) (when (buffer-live-p buffer) (kill-buffer buffer))))))

(ert-deftest web-tab-picker-filters-non-browser-buffers ()
  (let ((web--pages (make-hash-table)) selected)
    (with-temp-buffer
      (let ((browser (current-buffer)))
        (setq-local web--url "https://example.org/中文")
        (puthash 1 browser web--pages)
        (cl-letf (((symbol-function 'completing-read)
                   (lambda (_ choices &rest _)
                     (should (= (length choices) 1))
                     (should (string-match-p "中文" (caar choices)))
                     (caar choices)))
                  ((symbol-function 'web--select-buffer) (lambda (buffer) (setq selected buffer))))
          (web-switch-tab)
          (should (eq selected browser)))))))

(ert-deftest web-copied-address-respects-emacs-clipboard-and-target ()
  (let (calls)
    (cl-letf (((symbol-function 'current-kill)
               (lambda (n no-rotate) (should (= n 0)) (should no-rotate) "https://example.org/中文"))
              ((symbol-function 'web-open-url) (lambda (url) (push (cons 'current url) calls)))
              ((symbol-function 'web-open-new-url) (lambda (url) (push (cons 'new url) calls))))
      (web-open-copied-url)
      (web-open-copied-url-new-buffer)
      (should (equal (mapcar #'car calls) '(new current))))
    (cl-letf (((symbol-function 'current-kill) (lambda (&rest _) "  ")))
      (should-error (web-open-copied-url) :type 'user-error))))

(ert-deftest web-settings-routes-without-creating-or-selecting-a-tab ()
  (let (calls)
    (cl-letf (((symbol-function 'web--start) #'ignore)
              ((symbol-function 'web--native-command) (lambda (&rest args) (push args calls)))
              ((symbol-function 'web--make-tab) (lambda (&rest _) (error "Unexpected tab")))
              ((symbol-function 'web--select-buffer) (lambda (&rest _) (error "Unexpected selection"))))
      (with-temp-buffer
        (web-settings)
        (should (equal (pop calls) '(0 "settings" "")))
        (should-not (web "chrome://settings/"))
        (should (equal (pop calls) '(0 "settings" "chrome://settings/")))
        (web-open-new-url "chrome://settings/fonts")
        (should (equal (pop calls) '(0 "settings" "chrome://settings/fonts")))
        (web-open-url "CHROME://SETTINGS/languages")
        (should (equal (pop calls) '(0 "settings" "chrome://settings/languages")))
        (web-passwords)
        (should (equal (pop calls) '(0 "settings" "chrome://password-manager/")))
        (should-not (web "CHROME://PASSWORD-MANAGER/passwords"))
        (should (equal (pop calls) '(0 "settings" "chrome://password-manager/passwords")))
        (web-open-url "chrome://password-manager/settings")
        (should (equal (pop calls) '(0 "settings" "chrome://password-manager/settings")))
        (should-error (web-settings "chrome://password-manager.evil/") :type 'user-error)
        (should-error (web-settings "chrome://password-manager@evil/") :type 'user-error)
        (should-error (web-settings "chrome://settings.evil/") :type 'user-error)
        (should-error (web-settings "https://example.org") :type 'user-error)
        (should-not calls)))))
