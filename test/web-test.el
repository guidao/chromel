(ert-deftest web-background-focus-does-not-dismiss-minibuffer ()
  (let ((web--pages (make-hash-table)) selected)
    (with-temp-buffer
      (setq-local web--window (selected-window))
      (puthash 5 (current-buffer) web--pages)
      (cl-letf (((symbol-function 'active-minibuffer-window) (lambda () t))
