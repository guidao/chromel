;;; web-test.el --- Regression tests -*- lexical-binding: t; -*-
(require 'ert)
(require 'web)

(ert-deftest web-hints-prefix-backspace-and-invalid-input ()
  (let ((keys '(?a 127 ?z ?s ?a)) prefixes)
    (cl-letf (((symbol-function 'read-key) (lambda (&rest _) (pop keys)))
              ((symbol-function 'web--eval) (lambda (script) (push script prefixes) t)))
      (should (equal (plist-get
                      (web--read-hint '((:label "aa" :url "https://a.example")
                                        (:label "sa" :url "https://b.example")) "test") :url)
                     "https://b.example"))
      (should (= 4 (length prefixes)))
      (should (string-match-p "filter(\"\")" (nth 2 prefixes))))))

(ert-deftest web-hints-cancel-cleans-up-without-navigation ()
  (with-temp-buffer
    (let ((web--id 7) commands)
      (cl-letf (((symbol-function 'web--command)
                 (lambda (&rest args) (push args commands)))
                ((symbol-function 'web--eval)
                 (lambda (_) '((:label "a" :url "https://example.org"))))
                ((symbol-function 'read-key) (lambda (&rest _) (signal 'quit nil))))
        (should (eq 'cancelled (condition-case nil (web-follow) (quit 'cancelled))))
        (should (equal (mapcar #'car (reverse commands)) '("unfocus" "javascript")))
        (should (string-match-p "clear()" (cadar commands)))))))

(ert-deftest web-hints-new-buffer-uses-modified-click ()
  (with-temp-buffer
    (let ((web--id 7) (web--url "https://source.example") (requests 0) commands)
      (cl-letf (((symbol-function 'web--command)
                 (lambda (&rest args) (push args commands)))
                ((symbol-function 'web--eval)
                 (lambda (_)
                   (if (= 1 (cl-incf requests)) '((:label "a" :url "https://example.org/中文"))
                     '(:action "click" :x 10 :y 20 :link t))))
                ((symbol-function 'web--read-hint) (lambda (hints _) (car hints))))
        (web-follow-new-buffer)
        (should (equal web--url "https://source.example"))
        (should (equal (mapcar #'car (reverse commands)) '("unfocus" "click" "javascript")))
        (should (eq t (plist-get (json-parse-string (cadr (assoc "click" commands))
                                                  :object-type 'plist) :newBuffer)))))))

(ert-deftest web-hints-button-in-new-buffer-mode-still-clicks-in-place ()
  (with-temp-buffer
    (let ((web--id 7) (requests 0) commands)
      (cl-letf (((symbol-function 'web--command) (lambda (&rest args) (push args commands)))
                ((symbol-function 'web--eval)
                 (lambda (_) (if (= 1 (cl-incf requests)) '((:label "a"))
                               '(:action "click" :x 10 :y 20 :link :false))))
                ((symbol-function 'web--read-hint) (lambda (hints _) (car hints))))
        (web-follow-new-buffer)
        (should (eq :false (plist-get (json-parse-string (cadr (assoc "click" commands))
                                                       :object-type 'plist) :newBuffer)))))))

(ert-deftest web-hints-editable-is-focused-and-stale-target-is-not-clicked ()
  (dolist (action '((:action "focus") nil))
    (with-temp-buffer
      (let ((web--id 7) (requests 0) commands)
        (cl-letf (((symbol-function 'web--command) (lambda (&rest args) (push args commands)))
                  ((symbol-function 'web--eval)
                   (lambda (_) (if (= 1 (cl-incf requests)) '((:label "a")) action)))
                  ((symbol-function 'web--read-hint) (lambda (hints _) (car hints))))
          (if action (web-follow) (should-error (web-follow) :type 'user-error))
          (should-not (assoc "click" commands))
          (should (eq (not (null (assoc "focus" commands))) (not (null action)))))))))

(ert-deftest web-eval-ignores-late-response ()
  (let ((web--pages (make-hash-table)))
    (with-temp-buffer
      (setq-local web--eval-token "current")
      (puthash 7 (current-buffer) web--pages)
      (web--handle-event (list :id 7 :type "eval"
                              :value (web--json '(:token "old" :ok t :result "[]"))))
      (should-not web--eval-reply)
      (web--handle-event (list :id 7 :type "eval"
                              :value (web--json '(:token "current" :ok t :result "[]"))))
      (should (equal (plist-get web--eval-reply :token) "current")))))

(ert-deftest web-url-input ()
  (should (equal (web--normalize-url " example.org:8080/path ") "https://example.org:8080/path"))
  (should (equal (web--normalize-url "localhost:8000/a") "http://localhost:8000/a"))
  (should (equal (web--normalize-url "https://example.org/a?q=x") "https://example.org/a?q=x"))
  (should (equal (web--normalize-url "about:blank") "about:blank"))
  (should (equal (web--normalize-url "data:text/html,hello") "data:text/html,hello"))
  (should (string-prefix-p "https://duckduckgo.com/?q=" (web--normalize-url "emacs browser"))))

(ert-deftest web-history-roundtrip-dedup-and-limit ()
  (let ((web-data-directory (make-temp-file "web-history-" t))
        (web--history nil) (web--history-loaded t)
        (web--history-timer nil) (web-history-limit 2))
    (unwind-protect
        (progn
          (web--history-record "https://a.example" "a")
          (web--history-record "https://b.example" "b")
          (web--history-record "https://a.example" "updated")
          (web--history-record "https://c.example" "c")
          (web--history-record "data:text/html,private" "private")
          (should (= 2 (length web--history)))
          (should (equal (plist-get (cadr web--history) :title) "updated"))
          (cancel-timer web--history-timer)
          (web--history-save)
          (should (= #o600 (file-modes (expand-file-name "history.json" web-data-directory))))
          (setq web--history nil web--history-loaded nil)
          (web--history-load)
          (should (equal (mapcar (lambda (x) (plist-get x :url)) web--history)
                         '("https://c.example" "https://a.example"))))
      (when (timerp web--history-timer) (cancel-timer web--history-timer))
      (delete-directory web-data-directory t))))

(ert-deftest web-history-unicode-without-coding-prompt ()
  (let* ((web-data-directory (make-temp-file "web-history-unicode-" t))
         (entry (list :url "https://example.org/中文?q=café"
                      :title "中文页面 😀 — café" :time 1.0))
         (web--history (list entry)) (web--history-loaded t)
         (web--history-timer nil))
    (unwind-protect
        (cl-letf (((symbol-function 'read-coding-system)
                   (lambda (&rest _) (ert-fail "History must not prompt for an encoding"))))
          ;; Exercise the normal write path before testing ambient overrides.
          (web--history-save)
          (let ((coding-system-for-write 'iso-latin-1)
                (coding-system-for-read 'iso-latin-1))
            (web--history-save)
            (let ((bytes (with-temp-buffer
                           (set-buffer-multibyte nil)
                           (insert-file-contents-literally
                            (expand-file-name "history.json" web-data-directory))
                           (buffer-string))))
              (should (string-match-p
                       (regexp-quote (encode-coding-string (plist-get entry :title) 'utf-8-unix))
                       bytes)))
            (setq web--history nil web--history-loaded nil)
            (web--history-load)
            (should (equal web--history (list entry)))))
      (delete-directory web-data-directory t))))

(ert-deftest web-corrupt-history-is-not-overwritten ()
  (let ((web-data-directory (make-temp-file "web-history-" t))
        (web--history nil) (web--history-loaded nil))
    (unwind-protect
        (let ((file (expand-file-name "history.json" web-data-directory)))
          (with-temp-file file (insert "broken json"))
          (web--history-load)
          (web--history-save)
          (should (equal (with-temp-buffer (insert-file-contents file) (buffer-string))
                         "broken json")))
      (delete-directory web-data-directory t))))

(ert-deftest web-layout-follows-selected-split-and-hides ()
  (let ((web--initialized t) (web--pages (make-hash-table))
        (buffer (generate-new-buffer " *web-test*")) layouts hidden)
    (cl-letf (((symbol-function 'web--frame-handle) (lambda (_) 91))
              ((symbol-function 'frame-visible-p) (lambda (_) t))
              ((symbol-function 'web--native-layout) (lambda (&rest args) (push args layouts)))
              ((symbol-function 'web--native-hide) (lambda (id) (push id hidden)))
              ((symbol-function 'web--native-command) #'ignore))
      (unwind-protect
          (save-window-excursion
            (delete-other-windows)
            (switch-to-buffer buffer)
            (web-mode)
            (setq web--id 7)
            (puthash 7 buffer web--pages)
            (let ((right (split-window-right)))
              (set-window-buffer right buffer)
              (select-window right)
              (web--sync)
              (should (eq (buffer-local-value 'web--window buffer) right))
              (should (= (nth 2 (car layouts)) (car (window-inside-pixel-edges right)))))
            (delete-other-windows)
            (switch-to-buffer (get-buffer-create " *web-test-other*"))
            (web--sync)
            (should (equal hidden '(7))))
        (kill-buffer buffer)
        (when (get-buffer " *web-test-other*") (kill-buffer " *web-test-other*"))))))

(ert-deftest web-frame-title-restored-on-binding-failure ()
  (let ((web--frames (make-hash-table))
        (old (frame-parameter nil 'title)))
    (cl-letf (((symbol-function 'web--native-bind) (lambda (_) (error "bind failure"))))
      (should-error (web--frame-handle (selected-frame)))
      (should (equal old (frame-parameter nil 'title)))
      (should (= 0 (hash-table-count web--frames))))))

(ert-deftest web-changing-major-mode-releases-browser ()
  (let ((web--pages (make-hash-table)) commands)
    (cl-letf (((symbol-function 'web--native-command)
               (lambda (&rest args) (push args commands))))
      (with-temp-buffer
        (web-mode)
        (setq web--id 17)
        (puthash 17 (current-buffer) web--pages)
        (fundamental-mode)
        (should (equal commands '((17 "close" ""))))
        (should (= 0 (hash-table-count web--pages)))))))

