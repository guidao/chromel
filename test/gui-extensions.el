;;; gui-extensions.el --- Live Chrome Web Store regression -*- lexical-binding: t; -*-
(require 'chromel)
(setq chromel-data-directory (file-name-as-directory (getenv "CHROMEL_TEST_PROFILE")))
(module-load (expand-file-name "../build/chromel-ui-probe.dylib" (file-name-directory load-file-name)))
(defconst chromel-test--extension "bcjindcccaagfpapjjmafapmmgkkhgoa")
(defun chromel-test--assert (value text) (unless value (error "%s" text)))
(defun chromel-test--state () (json-parse-string (chromel--native-inspect 0) :object-type 'plist))
(defun chromel-test--wait (predicate text &optional seconds)
  (let ((deadline (+ (float-time) (or seconds 15))) done)
    (while (and (not (setq done (funcall predicate))) (< (float-time) deadline))
      (accept-process-output nil 0.1))
    (chromel-test--assert done text)))
(defun chromel-test--js (expression)
  (chromel--native-command 0 "test-settings-script" expression)
  (chromel-test--wait (lambda () (not (equal "" (plist-get (chromel-test--state) :testResult)))) "Management script timed out")
  (let* ((state (chromel-test--state))
         (result (json-parse-string (plist-get state :testResult) :object-type 'plist)))
    (chromel-test--assert (and (eq t (plist-get state :testSuccess)) (not (plist-get result :exceptionDetails)))
                      (format "Management script failed: %S" result))
    (plist-get (plist-get result :result) :value)))
(defun chromel-test--manager ()
  (chromel-extensions)
  (chromel-test--wait (lambda () (and (equal (plist-get (chromel-test--state) :url) "chrome://extensions/")
                                (equal (plist-get (chromel-test--state) :title) "Extensions"))) "Extension manager failed to load"))
(defun chromel-test--extension-info ()
  (chromel-test--js (format "new Promise(r=>chrome.management.getAll(es=>r(es.find(e=>e.id==='%s')||null)))" chromel-test--extension)))
(defun chromel-test--ui (label)
  (json-parse-string (chromel-test-ui-probe label) :object-type 'plist :array-type 'list))
(defun chromel-test--formatted-p ()
  (chromel--eval "JSON.stringify(!!document.querySelector('#jfStyleEl') && !!document.querySelector('#jsonFormatterRaw'))"))
(defun chromel-test--reload-and-check (enabled)
  (chromel-reload)
  (accept-process-output nil 1)
  (chromel-test--wait (lambda () (eq (if enabled t :false) (chromel-test--formatted-p))) (format "Extension did not become formatted=%S after reload" enabled)))
(defun chromel-test--run ()
  (condition-case err
      (progn
        (chromel-test--manager)
        (when (equal (getenv "CHROMEL_TEST_EXTENSION_PHASE") "seed")
          (chromel-test--assert (eq :null (chromel-test--extension-info)) "Test extension already installed")
          (chromel-settings (concat "https://chromewebstore.google.com/detail/json-formatter/" chromel-test--extension "?hl=en"))
          ;; The native permission dialog needs a visible parent to accept input.
          (chromel--native-command 0 "test-settings-show" "")
          (chromel-test--wait (lambda () (eq t (chromel-test--js "!![...document.querySelectorAll('button')].find(b=>b.innerText==='Add to Chrome'&&!b.disabled)"))) "Store install button not available" 45)
          (chromel-test--js "[...document.querySelectorAll('button')].find(b=>b.innerText==='Add to Chrome').click();true")
          (chromel-test--wait (lambda () (seq-find (lambda (n) (equal (plist-get n :label) "Add extension"))
                                              (plist-get (chromel-test--ui "") :nodes))) "Native permission prompt missing")
          (accept-process-output nil 1)
          (chromel-test--assert (eq t (plist-get (chromel-test--ui "Add extension") :pressed)) "Native confirmation failed")
          (chromel-test--wait (lambda () (eq t (chromel-test--js "document.body.innerText.includes('Remove from Chrome')"))) "Store download/install failed" 60)
          (chromel-test--manager))
        (let ((info (chromel-test--extension-info)))
          (chromel-test--assert (and (equal (plist-get info :id) chromel-test--extension)
                                (eq t (plist-get info :enabled))
                                (equal (plist-get info :installType) "normal")) "Extension not installed/enabled as a normal store extension"))
        (when (equal (getenv "CHROMEL_TEST_EXTENSION_PHASE") "seed")
          (chromel--native-command 0 "close-settings" "")
          (chromel-test--wait (lambda () (and (= 0 (plist-get (chromel-test--state) :count))
                                         (eq :false (plist-get (chromel-test--state) :windowAlive)))) "Extension windows did not close"))
        (chromel (getenv "CHROMEL_TEST_URL"))
        (accept-process-output nil 2)
        (chromel-test--wait (lambda () (eq t (chromel-test--formatted-p))) "Store extension did not format the embedded JSON page")
        (when (equal (getenv "CHROMEL_TEST_EXTENSION_PHASE") "restore")
          (chromel-test--assert (eq t (chromel-test--js (format "new Promise(r=>chrome.management.setEnabled('%s',false,()=>r(!chrome.runtime.lastError)))" chromel-test--extension))) "Disable failed")
          (chromel-test--reload-and-check nil)
          (chromel-test--assert (eq :false (plist-get (chromel-test--extension-info) :enabled)) "Disable did not persist in manager")
          (chromel-test--assert (eq t (chromel-test--js (format "new Promise(r=>chrome.management.setEnabled('%s',true,()=>r(!chrome.runtime.lastError)))" chromel-test--extension))) "Enable failed")
          (chromel-test--reload-and-check t)
          (chromel--native-command 0 "test-settings-show" "")
          (chromel-test--js (format "window.__uninstallResult=null;chrome.management.uninstall('%s',{showConfirmDialog:true},()=>{window.__uninstallResult={ok:!chrome.runtime.lastError,error:chrome.runtime.lastError?.message||null}});true" chromel-test--extension))
          (chromel-test--wait (lambda () (seq-find (lambda (n) (equal (plist-get n :label) "Remove"))
                                              (plist-get (chromel-test--ui "") :nodes))) "Native uninstall confirmation missing")
          (accept-process-output nil 1)
          (chromel-test--assert (eq t (plist-get (chromel-test--ui "Remove") :pressed)) "Uninstall confirmation failed")
          (chromel-test--wait (lambda () (eq t (plist-get (chromel-test--js "window.__uninstallResult") :ok))) "Uninstall failed")
          (chromel-test--assert (eq :null (chromel-test--extension-info)) "Uninstalled extension remains listed")
          (chromel-test--reload-and-check nil))
        (with-temp-file (getenv "CHROMEL_TEST_RESULT")
          (insert (format "PASS: Web Store extension %s, embedded content script, %s\n" chromel-test--extension (getenv "CHROMEL_TEST_EXTENSION_PHASE"))))
        (kill-emacs 0))
    (error
     (with-temp-file (getenv "CHROMEL_TEST_RESULT") (insert (format "FAIL: %S\n" err)))
     (kill-emacs 1))))
(run-at-time 0.2 nil #'chromel-test--run)
