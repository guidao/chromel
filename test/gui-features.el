;;; gui-features.el --- Search, scrolling and link workflow regressions -*- lexical-binding: t; -*-
(require 'web)
(setq web-data-directory (file-name-as-directory (getenv "WEB_TEST_PROFILE")))
(defvar web-test--source nil)
(defvar web-test--busy nil)
(defvar web-test--phase 'loading)
(defvar web-test--deadline (+ (float-time) 50))
(defun web-test--assert (value text) (unless value (error "%s" text)))
(defun web-test--js (expression) (web--eval (concat "JSON.stringify(" expression ")")))
(defun web-test--until (expression text)
  (let ((deadline (+ (float-time) 4)) done)
    (while (and (not done) (< (float-time) deadline))
      (setq done (eq t (web-test--js expression)))
      (unless done (accept-process-output nil 0.01)))
    (web-test--assert done (format "%s; state=%S focus=%s" text
                                  (web-test--js "({y:scrollY,panel:document.getElementById('panel').scrollTop,child:childState,active:document.activeElement.tagName})")
                                  (web--native-inspect web--id)))))
(defun web-test--finish (ok text)
  (with-temp-file (getenv "WEB_TEST_RESULT") (insert (if ok "PASS: " "FAIL: ") text "\n"))
  (kill-emacs (if ok 0 1)))
(defun web-test--click (x y &optional frame)
  (web-focus)
  (web--command "click" (web--json (list :x x :y y :newBuffer :false)))
  (accept-process-output nil 0.05)
  ;; Cross-process focus acknowledgement is asynchronous.  Test routing only
  ;; after CEF confirms the intended frame, rather than assuming 50 ms suffices.
  (when frame
    (let ((deadline (+ (float-time) 3)) focused)
      (while (and (not focused) (< (float-time) deadline))
        (web--tick)
        (setq focused (equal frame (plist-get (json-parse-string
                                               (web--native-inspect web--id) :object-type 'plist)
                                              :focusedFrameName)))
        (unless focused (accept-process-output nil 0.01)))
      (web-test--assert focused "CEF did not acknowledge clicked iframe focus")))
  (web--command "unfocus"))
(defun web-test--search ()
  (web-test--until "childState!==null" "Cross-origin frame did not load")
  (web-find "needlefeature")
  (web-test--assert (= web--find-count 4) (format "Find missed visible/frame matches: %d" web--find-count))
  (let ((ordinal web--find-ordinal))
    (web-find-next)
    (web-test--assert (= web--find-ordinal (1+ (mod ordinal 4))) "Next match did not advance/wrap")
    (web-find-previous)
    (web-test--assert (= web--find-ordinal ordinal) (format "Previous match did not return: initial=%d now=%d count=%d" ordinal web--find-ordinal web--find-count)))
  (web-find "中文检索")
  (web-test--assert (= web--find-count 3) "Unicode search failed")
  (web-find "[literal.*]")
  (web-test--assert (= web--find-count 1) "Search interpreted literal punctuation as a regex")
  (web-find "missing-feature-token")
  (web-test--assert (= web--find-count 0) "No-match search retained stale count")
  (web-find-clear)
  (web-test--assert (and (not web--find-active) (equal web--find-status "")) "Search clear retained status")
  (web-find "needlefeature")
  (web-find-clear)
  (web-find-next)
  (web-test--assert (and (= web--find-count 4) (> web--find-ordinal 0)) "Repeating a cleared query did not restart search")
  (web-find-clear)
  (web-focus-parent-frame t)
  (let ((deadline (+ (float-time) 3)))
    (while (and (< (float-time) deadline)
                (not (equal "" (plist-get (json-parse-string (web--native-inspect web--id) :object-type 'plist) :focusedFrameName))))
      (web--tick) (accept-process-output nil 0.01)))
  (web-scroll-to-top)
  (web-test--until "scrollY===0" "Search reset did not return to top"))
(defun web-test--scroll ()
  (let ((web-scroll-duration 0))
    (web-scroll-half-page-down)
    (web-test--until "scrollY===Math.round(document.scrollingElement.clientHeight/2)" "Half-page down used a fixed pixel step")
    (web-scroll-half-page-up)
    (web-test--until "scrollY===0" "Half-page up failed")
    (web-scroll-to-bottom)
    (web-test--until "scrollY===document.scrollingElement.scrollHeight-document.scrollingElement.clientHeight" "Bottom failed")
    (web-scroll-to-top)
    (web-test--until "scrollY===0" "Top failed")
    (web-test--click 80 115)
    (web-scroll-half-page-down)
    (web-test--until "document.getElementById('panel').scrollTop===100 && scrollY===0" "Half-page did not use panel height")
    (web-scroll-to-bottom)
    (web-test--until "document.getElementById('panel').scrollTop===800 && scrollY===0" "Bottom did not stay in panel")
    (web-scroll-to-top)
    (web-test--until "document.getElementById('panel').scrollTop===0" "Top did not stay in panel")
    (web-scroll-to-top)
    (web-test--until "scrollY===0" "Top at panel boundary escaped to outer page")
    (web-test--click 550 120 "feature-child")
    (web-scroll-half-page-down)
    (web-test--until "childState.y===Math.round(childState.height/2) && scrollY===0" "Half-page did not route to cross-origin iframe")
    (web-scroll-to-bottom)
    (web-test--until "childState.y===childState.max" "Bottom did not route to iframe")
    (web-scroll-to-top)
    (web-test--until "childState.y===0" "Top did not route to iframe")
    (web-focus-parent-frame t)))
(defun web-test--links ()
  ;; Keep the user's clipboard out of automated tests; capture kill-new values.
  (let (copied)
    (cl-letf (((symbol-function 'kill-new) (lambda (text &rest _) (setq copied text))))
      (web-copy-url)
      (web-test--assert (equal copied web--url) "Current URL was not copied")
      (setq web-test--phase 'copy)
      (let* ((hints (web--eval (format "%s(\"as\",\"inspect\",\"copy\")" (web--hint-script))))
             (hint (cl-find "中文 link" hints :key (lambda (h) (plist-get h :title)) :test #'equal)))
        (web-test--assert (= 4 (length hints)) "Copy hints included buttons/hidden links")
        (web--eval (web--hint-call "inspect" "clear"))
        (let ((unread-command-events (string-to-list (plist-get hint :label))) (web-hint-alphabet "as"))
          (web-copy-link))
        (web-test--assert (equal copied (web-test--js "document.getElementById('unicode').href")) "Link URL encoding/copy failed")
        (web-test--assert (= 0 (web-test--js "clicks")) "Copy triggered a link click"))))
  (setq web-test--phase 'queue)
  (let* ((hints (web--eval (format "%s(\"as\",\"inspect\",\"queue\")" (web--hint-script))))
         (keys (append (string-to-list (plist-get (nth 0 hints) :label))
                       (string-to-list (plist-get (nth 1 hints) :label))
                       (string-to-list (plist-get (nth 3 hints) :label)) '(escape)))
         (web-hint-alphabet "as"))
    (web--eval (web--hint-call "inspect" "clear"))
    (cl-letf (((symbol-function 'read-key) (lambda (&rest _) (or (pop keys) (error "Queue did not terminate")))))
      (web-follow-multiple)))
  (web-test--until "clicks===3 && intercepts===1" "Queued links bypassed real click handlers")
  (web-test--assert (eq (window-buffer (selected-window)) web-test--source) "Queue selected a new buffer")
  (web-test--until "document.querySelectorAll('[data-emacs-web-hints]').length===0" "Queue cancel left labels behind")
  (setq web-test--phase 'background))
(defun web-test--step ()
  (unless web-test--busy
    (let ((web-test--busy t))
      (condition-case err
          (with-current-buffer (if (buffer-live-p web-test--source) web-test--source (current-buffer))
            (when (> (float-time) web-test--deadline) (error "Feature test timed out: %s" web-test--phase))
            (pcase web-test--phase
              ('loading
               (when (equal web--title "features-ready")
                 (switch-to-buffer web-test--source) (delete-other-windows) (web--sync)
                 (when (fboundp 'meow-normal-mode) (meow-normal-mode 1))
                 (dolist (entry '(("C-c w s" . web-find) ("C-c w d" . web-scroll-half-page-down)
                                  ("C-c w f" . web-copy-link) ("C-c w m" . web-follow-multiple)))
                   (web-test--assert (eq (key-binding (kbd (car entry))) (cdr entry))
                                    (concat "Meow overrode " (car entry))))
                 (setq web-test--phase 'search) (web-test--search)
                 (setq web-test--phase 'scroll) (web-test--scroll)
                 (setq web-test--phase 'links) (web-test--links)))
              ('background
               (let ((others (cl-remove web-test--source (hash-table-values web--pages))))
                 (when (and (= (length others) 2)
                            (cl-every (lambda (b) (string-prefix-p "feature-target-" (buffer-local-value 'web--title b))) others))
                   (dolist (b others)
                     (with-current-buffer b
                       (let ((info (json-parse-string (web--native-inspect web--id) :object-type 'plist)))
                         (web-test--assert (and (eq t (plist-get info :hidden)) (eq :false (plist-get info :focused))) "Background browser became visible/focused"))
                       (web-test--assert (equal web--find-text "") "Search state leaked to another buffer")))
                   (web-test--assert (eq (window-buffer (selected-window)) web-test--source) "Late loading stole source selection")
                   (mapc #'kill-buffer others)
                   (setq web-test--phase 'closing)
                   (kill-buffer web-test--source))))))
        (error (web-test--finish nil (format "%s (phase %s)" (error-message-string err) web-test--phase))))))
  (when (and (eq web-test--phase 'closing) (string-match-p "Browsers including DevTools: 0" (web--native-info)))
    (web-test--finish t "Find including cross-origin/Unicode/repeat/no-match; half/top/bottom in page/panel/frame; copy without clicks; queued background links preserve focus and handlers")))
(run-at-time 1 nil (lambda ()
                    (setq web-test--source (web (getenv "WEB_TEST_URL")))
                    (run-at-time 0.2 0.2 #'web-test--step)))
